+"""
+vccl_alloc — multi-arena CUDA allocator backed by NCCL-allocated memory.
+
+Each named pool gets its OWN NCCL slab (Option B). At create_pool time you
+choose EXACTLY ONE NCCL registration kind for the slab:
+
+    REG_BUFFER  — ncclCommRegister        (zero-copy, fast IB / NVLink)
+    REG_WINDOW  — ncclCommWindowRegister  (one-sided / NVLS / SHARP)
+    REG_NONE    — no NCCL registration
+
+Buffer and window registrations are mutually exclusive per pool. To use both
+patterns of collective on the same data, use two pools.
+
+Typical usage:
+
+    import vccl_alloc
+
+    # At startup (anywhere convenient):
+    vccl_alloc.create_pool("kv_cache", slot_size=66*1024*1024, num_slots=64,
+                           register_kind=vccl_alloc.REG_BUFFER)
+    vccl_alloc.create_pool("nvls_buf", slot_size=66*1024*1024, num_slots=32,
+                           register_kind=vccl_alloc.REG_WINDOW)
+
+    # After init_process_group has produced NCCL communicators:
+    vccl_alloc.register_for_collectives(dp_comm)
+    vccl_alloc.register_for_collectives(tp_comm)
+
+    # Anywhere in Megatron:
+    with vccl_alloc.in_pool("kv_cache"):
+        cache = torch.empty(...)
+"""
+
+from .setup import (
+    # Lifecycle
+    create_pool,
+    destroy_pool,
+    get_pool,
+    get_pool_backing,
+    get_pool_slot_size,
+    get_pool_slot_num,
+    get_pool_slot_addr,
+    list_pools,
+
+    # Routing
+    in_pool,
+
+    # Zero-overhead slot tensors (no caching allocator, no with-block)
+    get_slot_byte_tensor,
+    get_slot_tensor,
+    acquire_slot_byte_tensor,
+    acquire_slot_tensor,
+    release_slot,
+
+    # Collectives
+    register_for_collectives,
+    deregister_collectives,
+
+    # Registration-kind constants
+    REG_BUFFER,
+    REG_WINDOW,
+    REG_NONE,
+
+    # State / diagnostics
+    is_enabled,
+    live_count,
+    peak_live,
+
+    # Constants
+    DEFAULT_SLOT_SIZE,
+    DEFAULT_NUM_SLOTS,
+    LOCAL_RANK,
+)
+
+__all__ = [
+    "create_pool",
+    "destroy_pool",
+    "get_pool",
+    "get_pool_backing",
+    "get_pool_slot_size",
+    "get_pool_slot_num",
+    "get_pool_slot_addr",
+    "list_pools",
+    "in_pool",
+    "get_slot_byte_tensor",
+    "get_slot_tensor",
+    "acquire_slot_byte_tensor",
+    "acquire_slot_tensor",
+    "release_slot",
+    "register_for_collectives",
+    "deregister_collectives",
+    "REG_BUFFER",
+    "REG_WINDOW",
+    "REG_NONE",
+    "is_enabled",
+    "live_count",
+    "peak_live",
+    "DEFAULT_SLOT_SIZE",
+    "DEFAULT_NUM_SLOTS",
+    "LOCAL_RANK",
+]
