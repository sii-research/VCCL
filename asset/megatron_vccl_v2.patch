+class DiffIndexSelectOut(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, input_tensor, sorted_indices, out_buffer):
+        # 1. Perform in-place selection without autograd tracking
+        with torch.no_grad():
+            torch.index_select(input_tensor, 0, sorted_indices, out=out_buffer)
+
+        # 2. Save only what's strictly needed for backward
+        ctx.save_for_backward(sorted_indices)
+        ctx.input_shape = input_tensor.shape
+        ctx.input_dtype = input_tensor.dtype
+        ctx.input_device = input_tensor.device
+
+        return out_buffer
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        sorted_indices, = ctx.saved_tensors
+
+        # 1. Initialize gradient tensor for the original input
+        grad_input = torch.zeros(
+            ctx.input_shape,
+            dtype=ctx.input_dtype,
+            device=ctx.input_device
+        )
+
+        # 2. Route gradients back to original positions
+        # index_add_ automatically SUMS gradients when multiple indices point to the same position
+        grad_input.index_add_(0, sorted_indices, grad_output)
+
+        # 3. Return gradients for (tokens, sorted_indices, out_buffer)
+        return grad_input, None, None
+
