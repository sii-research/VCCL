index 000000000..f27e52a6f
--- /dev/null
+++ b/vccl_alloc/vccl_arena_allocator.cu
@@ -0,0 +1,311 @@
+// vccl_arena_allocator.cu — multi-arena fixed-slot CUDA allocator for
+// vccl-megatron. Implements the C ABI used by torch.cuda.memory.
+// CUDAPluggableAllocator, plus sideband entry points that Python calls via
+// ctypes from vccl_alloc/setup.py.
+//
+// Model:
+//   * Multiple named arenas. Each arena has its own backing slab + slot config.
+//   * Arenas are created via my_alloc_create_arena(name, base, slot_size,
+//     num_slots, device, owns) called from Python (typically once per pool).
+//   * A thread-local "active arena" stack is pushed/popped by Python around
+//     each `with use_mem_pool(p):` block via my_alloc_push_arena / pop_arena.
+//   * my_malloc looks at the top of the thread-local stack to choose an
+//     arena, then carves a slot from it. my_free uses a global ptr→arena map.
+//
+// Compile (run from vccl-megatron/vccl_alloc/):
+//   nvcc -Xcompiler -fPIC -shared -std=c++17 \
+//        -o libvccl_arena_allocator.so vccl_arena_allocator.cu
+
+#include <cuda_runtime_api.h>
+#include <sys/types.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+struct Arena {
+    std::string name;
+    std::mutex  mu;                     // protects slot bitmap, cursor, counts
+    void*       base        = nullptr;
+    size_t      slot_size   = 0;
+    int         num_slots   = 0;
+    int         device      = -1;
+    bool        owns_memory = false;
+    std::vector<uint8_t> in_use;
+    int         cursor      = -1;
+    int         live_count  = 0;
+    int         peak_live   = 0;
+};
+
+struct Registry {
+    std::mutex mu;                                                 // protects both maps
+    std::unordered_map<std::string, std::unique_ptr<Arena>> arenas;
+    std::unordered_map<void*, Arena*>                       ptr_to_arena;
+};
+
+// Heap-allocated, never deleted: avoids static-destruction-order crashes
+// when PyTorch issues a final my_free during process teardown.
+Registry& reg() {
+    static Registry* r = new Registry();
+    return *r;
+}
+
+// Per-thread active-arena stack. push_arena / pop_arena modify it; my_malloc
+// reads the top to decide which arena to allocate from.
+thread_local std::vector<std::string> tls_arena_stack;
+
+}  // anonymous namespace
+
+extern "C" {
+
+// ----- Arena lifecycle ----------------------------------------------------
+
+int my_alloc_create_arena(const char* name, void* base, size_t slot_size,
+                          int num_slots, int device, int owns) {
+    if (!name || !base || slot_size == 0 || num_slots <= 0) {
+        std::fprintf(stderr, "[my_alloc] create_arena: invalid args\n");
+        return 1;
+    }
+    auto& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+
+    if (r.arenas.find(name) != r.arenas.end()) {
+        std::fprintf(stderr, "[my_alloc] create_arena: '%s' already exists\n", name);
+        return 2;
+    }
+    auto a = std::make_unique<Arena>();
+    a->name        = name;
+    a->base        = base;
+    a->slot_size   = slot_size;
+    a->num_slots   = num_slots;
+    a->device      = device;
+    a->owns_memory = (owns != 0);
+    a->in_use.assign(static_cast<size_t>(num_slots), 0);
+
+    std::fprintf(stderr,
+        "[my_alloc] arena='%s' created: slot_size=%zu MiB num_slots=%d "
+        "base=%p device=%d owns=%d\n",
+        name, slot_size >> 20, num_slots, base, device, owns);
+
+    r.arenas[name] = std::move(a);
+    return 0;
+}
+
+int my_alloc_destroy_arena(const char* name) {
+    if (!name) return 1;
+    auto& r = reg();
+
+    std::unique_ptr<Arena> doomed;     // holds the arena alive until end of fn
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        auto it = r.arenas.find(name);
+        if (it == r.arenas.end()) {
+            std::fprintf(stderr, "[my_alloc] destroy_arena: '%s' not found\n", name);
+            return 2;
+        }
+        if (it->second->live_count != 0) {
+            std::fprintf(stderr,
+                "[my_alloc] destroy_arena='%s': WARNING %d slots still live\n",
+                name, it->second->live_count);
+        }
+        // Remove every ptr_to_arena entry pointing at this arena.
+        Arena* raw = it->second.get();
+        for (auto pit = r.ptr_to_arena.begin(); pit != r.ptr_to_arena.end(); ) {
+            if (pit->second == raw) pit = r.ptr_to_arena.erase(pit);
+            else                    ++pit;
+        }
+        // Move arena out of the map; it dies when `doomed` exits scope.
+        doomed = std::move(it->second);
+        r.arenas.erase(it);
+    }
+    if (doomed->owns_memory && doomed->base) {
+        cudaSetDevice(doomed->device);
+        cudaFree(doomed->base);
+    }
+    std::fprintf(stderr, "[my_alloc] arena='%s' destroyed\n", name);
+    return 0;
+}
+
+void my_alloc_shutdown(void) {
+    auto& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    for (auto& kv : r.arenas) {
+        Arena* a = kv.second.get();
+        if (a->live_count != 0) {
+            std::fprintf(stderr,
+                "[my_alloc] shutdown: arena='%s' has %d live slots\n",
+                a->name.c_str(), a->live_count);
+        }
+        if (a->owns_memory && a->base) {
+            cudaSetDevice(a->device);
+            cudaFree(a->base);
+        }
+    }
+    r.arenas.clear();
+    r.ptr_to_arena.clear();
+    std::fprintf(stderr, "[my_alloc] shutdown complete\n");
+}
+
+// ----- Active-arena stack (called from Python around use_mem_pool) -------
+
+void my_alloc_push_arena(const char* name) {
+    if (!name) return;
+    tls_arena_stack.emplace_back(name);
+}
+
+void my_alloc_pop_arena(void) {
+    if (!tls_arena_stack.empty()) tls_arena_stack.pop_back();
+}
+
+// ----- Diagnostics --------------------------------------------------------
+
+int my_alloc_arena_live_count(const char* name) {
+    if (!name) return -1;
+    auto& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    auto it = r.arenas.find(name);
+    if (it == r.arenas.end()) return -1;
+    Arena* a = it->second.get();
+    std::lock_guard<std::mutex> lka(a->mu);
+    return a->live_count;
+}
+
+int my_alloc_arena_peak_live(const char* name) {
+    if (!name) return -1;
+    auto& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    auto it = r.arenas.find(name);
+    if (it == r.arenas.end()) return -1;
+    return it->second->peak_live;
+}
+
+int my_alloc_arena_num_slots(const char* name) {
+    if (!name) return -1;
+    auto& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    auto it = r.arenas.find(name);
+    if (it == r.arenas.end()) return -1;
+    return it->second->num_slots;
+}
+
+size_t my_alloc_arena_slot_size(const char* name) {
+    if (!name) return 0;
+    auto& r = reg();
+    std::lock_guard<std::mutex> lk(r.mu);
+    auto it = r.arenas.find(name);
+    if (it == r.arenas.end()) return 0;
+    return it->second->slot_size;
+}
+
+// ----- PyTorch-facing entry points ---------------------------------------
+
+void* my_malloc(ssize_t size, int device, cudaStream_t /*stream*/) {
+    if (size <= 0) return nullptr;
+    if (tls_arena_stack.empty()) {
+        std::fprintf(stderr,
+            "[my_alloc] my_malloc(size=%zd) with no active arena; "
+            "did you forget `with vccl_alloc.in_pool(name):` ?\n", size);
+        return nullptr;
+    }
+    const std::string& name = tls_arena_stack.back();
+
+    Arena* a = nullptr;
+    auto& r = reg();
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        auto it = r.arenas.find(name);
+        if (it == r.arenas.end()) {
+            std::fprintf(stderr, "[my_alloc] arena '%s' not registered\n", name.c_str());
+            return nullptr;
+        }
+        a = it->second.get();
+    }
+
+    void* p = nullptr;
+    {
+        std::lock_guard<std::mutex> lk(a->mu);
+        if (device != a->device) {
+            std::fprintf(stderr,
+                "[my_alloc] arena='%s' device mismatch req=%d arena=%d\n",
+                name.c_str(), device, a->device);
+            return nullptr;
+        }
+        if (static_cast<size_t>(size) > a->slot_size) {
+            std::fprintf(stderr,
+                "[my_alloc] arena='%s' reject size=%zd (slot_size=%zu)\n",
+                name.c_str(), size, a->slot_size);
+            return nullptr;
+        }
+        int start = (a->cursor + 1) % a->num_slots;
+        int chosen = -1;
+        for (int step = 0; step < a->num_slots; ++step) {
+            int idx = (start + step) % a->num_slots;
+            if (!a->in_use[idx]) { chosen = idx; break; }
+        }
+        if (chosen < 0) {
+            std::fprintf(stderr,
+                "[my_alloc] arena='%s' OOM: all %d slots in use (peak=%d)\n",
+                name.c_str(), a->num_slots, a->peak_live);
+            return nullptr;
+        }
+        a->in_use[chosen] = 1;
+        a->cursor         = chosen;
+        a->live_count    += 1;
+        if (a->live_count > a->peak_live) a->peak_live = a->live_count;
+        p = static_cast<char*>(a->base) + static_cast<size_t>(chosen) * a->slot_size;
+        std::fprintf(stderr,
+            "[my_alloc] arena='%s' malloc size=%zd -> slot=%d ptr=%p (live=%d/%d)\n",
+            name.c_str(), size, chosen, p, a->live_count, a->num_slots);
+    }
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        r.ptr_to_arena[p] = a;
+    }
+    return p;
+}
+
+void my_free(void* ptr, ssize_t /*size*/, int /*device*/, cudaStream_t /*stream*/) {
+    if (!ptr) return;
+    auto& r = reg();
+    Arena* a = nullptr;
+    {
+        std::lock_guard<std::mutex> lk(r.mu);
+        auto it = r.ptr_to_arena.find(ptr);
+        if (it == r.ptr_to_arena.end()) {
+            std::fprintf(stderr, "[my_alloc] free: ptr %p not from any arena\n", ptr);
+            return;
+        }
+        a = it->second;
+        r.ptr_to_arena.erase(it);
+    }
+
+    std::lock_guard<std::mutex> lk(a->mu);
+    char* cbase = static_cast<char*>(a->base);
+    char* cptr  = static_cast<char*>(ptr);
+    ptrdiff_t off = cptr - cbase;
+    if (off < 0 || static_cast<size_t>(off) >= a->slot_size * a->num_slots) {
+        std::fprintf(stderr,
+            "[my_alloc] free: ptr %p out of range for arena='%s'\n",
+            ptr, a->name.c_str());
+        return;
+    }
+    int idx = static_cast<int>(static_cast<size_t>(off) / a->slot_size);
+    if (!a->in_use[idx]) {
+        std::fprintf(stderr,
+            "[my_alloc] arena='%s' double-free at slot %d\n", a->name.c_str(), idx);
+        return;
+    }
+    a->in_use[idx] = 0;
+    a->live_count -= 1;
+    std::fprintf(stderr,
+        "[my_alloc] arena='%s' free   slot=%d ptr=%p (live=%d/%d)\n",
+        a->name.c_str(), idx, ptr, a->live_count, a->num_slots);
+}
+
+}  // extern "C"
