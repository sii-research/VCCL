+def compute_pool_slot_count(args: Any) -> int:
+    """Worst-case concurrently-live dispatch recvbufs on the most-loaded rank.
+
+    Each VCCLManager.dispatch() call allocates a fresh recvbuf out of the
+    shared vccl_alloc pool; that recvbuf stays alive until autograd's saved-
+    tensors for the layer's forward computation are released (i.e., not until
+    backward consumes them). So peak slot occupancy is
+
+        peak_slots = (concurrent in-flight microbatches on this rank)
+                       * (MoE layers per pipeline stage on this rank)
+
+    Computing each factor:
+
+    * In-flight microbatches per rank — mirrors the schedule formula in
+      `vccl-megatron/megatron/training/theoretical_memory_usage.py:224-247`:
+        - Plain 1F1B (no VPP): pp_size.
+        - Interleaved PP (vp_size >= 2):
+          ceil(pp_size + (pp_size - 1) / vp_size) * vp_size,
+          i.e. `in_flight_microbatches * vp_size`.
+
+    * MoE layers per pipeline stage — conservatively assume every transformer
+      layer is a MoE layer (true for dense MoE; overestimates by ~2x when
+      only every-other layer is MoE, which is a safe direction). With pp_size
+      ranks the most-loaded rank holds `ceil(num_layers / pp_size)` layers
+      total, regardless of how VPP further interleaves them across chunks
+      (VPP is a scheduling choice; the layer count per rank is unchanged).
+
+    Returns the product, floored to 1 if either factor is unknown.
+    """
+    pp_size = getattr(args, "pipeline_model_parallel_size", 1) or 1
+    vp_size = getattr(args, "virtual_pipeline_model_parallel_size", None)
+    num_layers = getattr(args, "num_layers", 1) or 1
+
+    # Layers per pipeline stage on the most-loaded rank.
+    layers_per_stage = max(1, math.ceil(num_layers / pp_size))
+
+    # In-flight microbatches per rank.
+    if vp_size is None or vp_size <= 1:
+        in_flight = pp_size
+    else:
+        penalty = 1.0 + (pp_size - 1) / (pp_size * vp_size)
+        in_flight = math.ceil(penalty * pp_size) * vp_size
+
+    num_slots = int(max(1, in_flight) * layers_per_stage)
+
+    if torch.distributed.is_initialized() and torch.distributed.get_rank() == 0:
+        print(f"[vccl_utils] compute_pool_slot_count: in_flight={in_flight} "
+              f"layers_per_stage={layers_per_stage} num_slots={num_slots}",
+              flush=True)
+
+    return num_slots
+
+
+class VCCLManager:
+    """
+    VCCLManager is a class that manages the VCCL communication.
+
+    Setup workflow (in __init__):
+    (1) Initialize the VCCL communicator for the expert-model-parallel group.
+    (2) Acquire the shared main slab from vccl_alloc, register it on the
+        EP comm, and build typed tensor views over its regions.
+    (3) Set up the dispatch-recvbuf vccl_alloc pool (separate slab).
+
+    Public operations:
+    (1) setup_metadata: compute sendcounts/recvcounts/displs for VCCL AllToAllV.
+    (2) dispatch:       send tokens (and probs) across the EP group.
+    (3) combine:        gather expert outputs back across the EP group.
+    """
+
+    # (tensor attribute name, size attribute name) in contiguous layout order.
+    # Each entry maps a region of the main slab to a typed tensor view
+    # stored on the manager. The intermediate VcclBuffer wrapper used to
+    # build each view is local to _init_main_slab and discarded.
+    # Note: output_prob_fwd is intentionally absent from this spec — the
+    # dispatch-side prob and token recvbufs both live in a separate
+    # vccl_alloc pool (see _init_output_dispatch_fwd_pool_via_vccl_alloc
+    # and dispatch()). output_prob_fwd_buf_size is still used to size and
+    # offset the prob region of that pool slot.
+    _VCCL_BUFFER_SPECS: Tuple[Tuple[str, str], ...] = (
+        ("input_token_fwd_tensor", "input_token_fwd_buf_size"),
+        ("input_token_bwd_tensor", "input_token_bwd_buf_size"),
+        ("input_prob_fwd_tensor", "input_prob_fwd_buf_size"),
+        ("input_prob_bwd_tensor", "input_prob_bwd_buf_size"),
+        ("output_token_fwd_tensor", "output_token_fwd_buf_size"),
+        ("output_token_bwd_tensor", "output_token_bwd_buf_size"),
+        ("output_prob_bwd_tensor", "output_prob_bwd_buf_size"),
+        ("relay_tensor", "relay_buf_size"),
+    )
+
+    # Name used for the vccl_alloc pool that backs the dispatch recvbufs.
+    # The slot holds BOTH the dispatch-side prob recvbuf and the dispatch-side
+    # token recvbuf, in that order:
+    #   [output_prob_fwd_buf_size bytes | output_token_fwd_buf_size bytes]
+    # The two offsets are derived from config-only quantities (bs, seq_len,
+    # topk, hidden_size, dtype), identical on every rank, so the
+    # ncclCommWindowRegister cross-rank symmetric-offset requirement holds
+    # for both regions.
+    _VCCL_ALLOC_POOL_OUTPUT_DISPATCH_FWD: str = "vccl_mgr_output_dispatch_fwd"
+
+    # Name of the vccl_alloc pool backing the SHARED main slab
+    # (self._buffer). All VCCLManager instances in a process — one per MoE
+    # layer — alias the same physical slab via this pool (num_slots=1,
+    # slot_size=_buf_size). See _init_main_slab for the sharing-safety
+    # argument.
+    _VCCL_ALLOC_POOL_MAIN_BUF: str = "vccl_mgr_main_buf"
+
+    def __init__(
+        self,
+        config: TransformerConfig,
+        pg_collection: Optional[ProcessGroupCollection] = None,
+    ) -> None:
+        # ensure pg_collection is initialized
+        assert pg_collection is not None, (
+            f"{self.__class__.__name__}: ProcessGroupCollection must be provided"
+        )
+
+        # FIXME: alltoall methods: alltoall, alltoallv
+        self.method = "alltoallv"
+
+        # internal variables
+        self._ep_group = pg_collection.ep  # torch process group (pg) for ep parallel
+        self._tp_group = pg_collection.expt_tp  # NOTE: for future use
+        self._tp_ep_group = pg_collection.tp_ep  # torch pg for tp ep tp parallel
+        self._tp_size = utils.get_pg_size(self._tp_group)
+        self._tp_rank = utils.get_pg_rank(self._tp_group)
+        self._ep_size = utils.get_pg_size(self._ep_group)
+        self._ep_rank = utils.get_pg_rank(self._ep_group)
+        self._rank = torch.distributed.get_rank()
+        self._device_id = self._rank % torch.cuda.device_count()
+        self._device = torch.device(f"cuda:{self._device_id}")
+        # Set in _init_main_slab() to the shared main-slab NcclBuffer.
+        self._buffer = None
+        self._comm: Optional[nccl.Communicator] = None
+        # Resolved lazily on first dispatch/combine; pinned to the pipeline comm stream
+        # so AlltoAllv kernels land on the comm stream even if the caller's current
+        # stream is something else. Stays None when set_streams() hasn't been called.
+        self._comm_stream_ptr: Optional[int] = None
+
+        # parse moe arguments
+        try:
+            topk: int = config.moe_router_topk
+            hidden_size: int | None = config.hidden_size
+            num_moe_experts: int | None = config.num_moe_experts
+            assert topk is not None, "topk must be provided"
+            assert hidden_size is not None, "hidden_size must be provided"
+            assert num_moe_experts is not None, "num_moe_experts must be provided"
+        except Exception as e:
+            raise RuntimeError(
+                f"{self.__class__.__name__}: fail to parse topk/hidden_size/num_moe_experts: {e}"
+            )
+        self._num_experts = num_moe_experts
+        self._num_local_experts_per_ep_rank = self._num_experts // self._ep_size
+        self._hidden_size = hidden_size
+
+        # buffer size
+        args = get_args()
+        assert args is not None, f"{self.__class__.__name__}: global args is None!"
+        try:
+            bs: int = args.micro_batch_size
+            seq_len: int = args.seq_length
+            params_dtype: torch.dtype = args.params_dtype
+            assert bs is not None, "bs must be provided"
+            assert hidden_size is not None, "hidden_size must be provided"
+            assert params_dtype is not None, "params_dtype must be provided"
+        except Exception as e:
+            raise RuntimeError(
+                f"{self.__class__.__name__}: fail to parse bs/seq_len/params_dtype: {e}"
+            )
+
+        self._params_dtype = params_dtype
+        self._nccl_dtype = _to_nccl_dtype(params_dtype)
+
+        # Determine prob dtype from --moe-router-dtype (may differ from params_dtype)
+        _moe_router_dtype = getattr(config, 'moe_router_dtype', None)
+        if _moe_router_dtype == 'fp32':
+            prob_dtype = torch.float32
+        elif _moe_router_dtype == 'fp64':
+            prob_dtype = torch.float64
+        else:
+            prob_dtype = params_dtype
+        self._prob_dtype = prob_dtype
+        self._prob_nccl_dtype = _to_nccl_dtype(prob_dtype)
+
+        # TODO: buffer size may need to be aligned to 128B ?
+        self._element_size = params_dtype.itemsize
+        self._prob_element_size = prob_dtype.itemsize
+        # When expert_tensor_parallel_size > 1, each TP rank handles a portion of tokens
+        unit_count = bs * seq_len * topk // self._tp_size
+        token_unit = unit_count * hidden_size * self._element_size
+        prob_unit = unit_count * self._prob_element_size
+        # To prevent overflow, actual buffer sizes are reserved at 2x the minimum unit
+        token_buf_size = token_unit * 2
+        prob_buf_size = prob_unit * 2
+
+        self._base_buf_size = token_unit + prob_unit
+
+        self.input_token_fwd_buf_size = token_buf_size
+        self.input_token_bwd_buf_size = token_buf_size
+        self.input_prob_fwd_buf_size = prob_buf_size
+        self.input_prob_bwd_buf_size = prob_buf_size
+        self.output_token_fwd_buf_size = token_buf_size
+        self.output_token_bwd_buf_size = token_buf_size
+        self.output_prob_fwd_buf_size = prob_buf_size
+        self.output_prob_bwd_buf_size = prob_buf_size
+        self.relay_buf_size = self._base_buf_size * 2
+
+        # Total buffer size: sum of every spec in _VCCL_BUFFER_SPECS.
+        # output_token_fwd is back in this main slab (used by combine);
+        # the dispatch-side recvbufs (BOTH prob and token) live in a
+        # separate vccl_alloc pool whose slot size is
+        # output_prob_fwd_buf_size + output_token_fwd_buf_size.
+        self._buf_size = sum(
+            getattr(self, size_attr) for _, size_attr in self._VCCL_BUFFER_SPECS
+        )
+        self.log(f"Base buffer size: {self._base_buf_size / (2**20)} MB")
+        self.log(f"Total buffer size: {self._buf_size / (2**20)} MB")
+        self.log(
+            f"output_dispatch_fwd buffer size (vccl_alloc, prob+token): "
+            f"{(self.output_prob_fwd_buf_size + self.output_token_fwd_buf_size) / (2**20)} MB"
+        )
+
+        # Pre-allocated tensor views over main-slab regions; populated by
+        # _init_main_slab from _VCCL_BUFFER_SPECS. These are the only handles
+        # to the slab kept on self — the intermediate VcclBuffer wrappers
+        # are local to _init_main_slab and discarded.
+        self.input_token_fwd_tensor: Optional[torch.Tensor] = None
+        self.input_token_bwd_tensor: Optional[torch.Tensor] = None
+        self.input_prob_fwd_tensor: Optional[torch.Tensor] = None
+        self.input_prob_bwd_tensor: Optional[torch.Tensor] = None
+        self.output_token_fwd_tensor: Optional[torch.Tensor] = None
+        self.output_token_bwd_tensor: Optional[torch.Tensor] = None
+        self.output_prob_bwd_tensor: Optional[torch.Tensor] = None
+        self.relay_tensor: Optional[torch.Tensor] = None
+
+        # vccl_alloc-backed dispatch recvbuf. Each dispatch() call acquires
+        # a free slot via vccl_alloc.acquire_slot_byte_tensor and stashes
+        # the byte tensor here so the eventual release_slot call can find
+        # it. Per-region typed views (prob, token — possibly different
+        # dtypes) are constructed locally inside dispatch() and passed
+        # straight into the alltoallv calls; they're not stored on `self`.
+        self.output_dispatch_fwd_byte_tensor: Optional[torch.Tensor] = None
+
+        # Initialize expert-model-parallel communication and acquire two
+        # process-wide-shared vccl_alloc pools:
+        #   * The main-slab pool (one slot, REG_WINDOW): all VCCLManager
+        #     instances share the same physical slab.
+        #   * The dispatch-recvbuf pool (compute_pool_slot_count slots,
+        #     REG_WINDOW): provides a fresh slot per dispatch() call.
+        # Order is significant:
+        #   1) EP comm setup — produces self._comm; needed by
+        #      register_for_collectives in the pool init steps below.
+        #   2) _init_main_slab — sets up the main-slab pool, registers
+        #      it on self._comm, binds self._buffer to the backing
+        #      NcclBuffer, and builds typed tensor views over the slab
+        #      regions declared in _VCCL_BUFFER_SPECS.
+        #   3) _init_output_dispatch_fwd_pool_via_vccl_alloc — sets up
+        #      the dispatch-recvbuf pool (separate slab); tensor
+        #      allocation is deferred to dispatch().
+        self._comm = get_expert_model_parallel_comm(self._ep_group)
+        if self._comm is not None:
+            self.log("Expert Model Parallel Communication Initialized")
+        self._init_main_slab()
+        self._init_output_dispatch_fwd_pool_via_vccl_alloc()
+
+        # One-time invariant check. After this, dispatch()/combine() can skip
+        # re-checking buffers/comm/method every call.
+        assert self._comm is not None, (
+            f"{self.__class__.__name__}: comm not initialized"
+        )
+        assert self.method == "alltoallv", (
+            f"{self.__class__.__name__}: unsupported method {self.method}"
+        )
+        for tensor_attr, _ in self._VCCL_BUFFER_SPECS:
+            assert getattr(self, tensor_attr) is not None, (
+                f"{self.__class__.__name__}: {tensor_attr} not initialized"
+            )
+
+        # Cache storage ptrs to avoid per-call .untyped_storage().data_ptr() chains.
+        self._input_token_fwd_storage_ptr = (
+            self.input_token_fwd_tensor.untyped_storage().data_ptr()
+        )
+        self._input_prob_fwd_storage_ptr = (
+            self.input_prob_fwd_tensor.untyped_storage().data_ptr()
+        )
+
+        # Populated by setup_metadata() each forward.
+        self.expected_num_dispatch_send_tokens: int = 0
+        self.expected_num_dispatch_recv_tokens: int = 0
+        self.expected_num_combine_send_tokens: int = 0
+        self.expected_num_combine_recv_tokens: int = 0
+
+    def log(self, msg: str, verbose: bool = False) -> str:
+        msg = f"{self.__class__.__name__}: {msg}"
+        if verbose:
+            print(msg)
+        return msg
+
+    def setup_metadata(self, num_global_tokens_per_expert: torch.Tensor):
+        """Compute sendcounts/recvcounts/displs from num_global_tokens_per_expert.
+
+        Args:
+            num_global_tokens_per_expert (torch.Tensor): Tensor of shape
+                (tp_size, ep_size, num_experts).
+
+        Notes:
+              * ``*_sendcounts_raw`` / ``*_recvcounts_raw`` : ``np.int64`` token-object
+                counts, used for local size arithmetic (``expected_num_*_tokens``).
+              * ``dispatch_token_*`` / ``combine_token_*``  : ``np.uintp`` arrays already
+                scaled by ``hidden_size`` — passed straight into ``VcclAlltoAllv.apply``
+                for 2D token tensors.
+              * ``dispatch_prob_*`` / ``combine_prob_*``    : ``np.uintp`` arrays with
+                unit scale — passed straight into ``VcclAlltoAllv.apply`` for 1D prob
+                tensors.
+
+            Combine is dispatch with send/recv swapped.
+            Metadata is consumed by python lists in alltoallv, so keep this CPU-native.
+        """
+        tp_rank = self._tp_rank
+        tp_size = self._tp_size
+        ep_size = self._ep_size
+        num_local_experts_per_rank = self._num_local_experts_per_ep_rank
+
+        # The 2D metadata array is at most ep_size*ep_size int64s (a few KB).
+        # Per-op GPU launch + DtoH latency (15-70us each) dwarfs the arithmetic,
+        # so we DtoH the routing tensor once and do all downstream work in numpy,
+        # where each op costs microseconds.
+        routing_np = num_global_tokens_per_expert.to(torch.int64).cpu().numpy()
+        sendcounts_2d = np.ascontiguousarray(
+            routing_np.reshape(tp_size, ep_size, ep_size, num_local_experts_per_rank)
+                .sum(axis=-1)[tp_rank]
+        )
+        recvcounts_2d = np.ascontiguousarray(sendcounts_2d.T)
+
+        # Exclusive row-wise prefix sum: displs[r, 0] = 0, displs[r, c>0] = sum(counts[r, :c]).
+        sdispls_2d = np.empty_like(sendcounts_2d)
+        sdispls_2d[:, 0] = 0
+        sdispls_2d[:, 1:] = sendcounts_2d[:, :-1].cumsum(axis=1)
+        rdispls_2d = np.empty_like(recvcounts_2d)
+        rdispls_2d[:, 0] = 0
+        rdispls_2d[:, 1:] = recvcounts_2d[:, :-1].cumsum(axis=1)
+
+        # Flatten: .reshape(-1) on a C-contiguous array returns a view.
+        send_i64 = sendcounts_2d.reshape(-1)
+        recv_i64 = recvcounts_2d.reshape(-1)
+        sdisp_i64 = sdispls_2d.reshape(-1)
+        rdisp_i64 = rdispls_2d.reshape(-1)
+
+        # Pre-compute this rank's total send/recv token counts — dispatch()/combine()
+        # would otherwise re-sum these per call. Exploit that sdispls/rdispls already
+        # hold exclusive prefix sums, so row_total = last_displ + last_count — two
+        # scalar fetches, no .sum() ufunc dispatch.
+        ep_rank = self._ep_rank
+        self.expected_num_dispatch_send_tokens = (
+            sdispls_2d[ep_rank, -1] + sendcounts_2d[ep_rank, -1]
+        ).item()
+        self.expected_num_dispatch_recv_tokens = (
+            rdispls_2d[ep_rank, -1] + recvcounts_2d[ep_rank, -1]
+        ).item()
+        self.expected_num_combine_send_tokens = self.expected_num_dispatch_recv_tokens
+        self.expected_num_combine_recv_tokens = self.expected_num_dispatch_send_tokens
+
+        # Raw (int64) — used for local size arithmetic only.
+        self.dispatch_sendcounts_raw = send_i64
+        self.dispatch_recvcounts_raw = recv_i64
+        self.combine_sendcounts_raw = recv_i64
+        self.combine_recvcounts_raw = send_i64
+
+        # Prob (1D): no scaling; zero-copy reinterpret int64 -> uintp (same bit-width on
+        # 64-bit platforms, counts are non-negative so the bit pattern is unchanged).
+        self.dispatch_prob_sendcounts = send_i64.view(np.uintp)
+        self.dispatch_prob_recvcounts = recv_i64.view(np.uintp)
+        self.dispatch_prob_sdispls = sdisp_i64.view(np.uintp)
+        self.dispatch_prob_rdispls = rdisp_i64.view(np.uintp)
+
+        # Token (2D): pre-scale by hidden_size so C++ consumes element counts directly.
+        # ``* H`` produces a fresh contiguous int64 array; ``.view(np.uintp)`` reinterprets.
+        H = self._hidden_size
+        self.dispatch_token_sendcounts = (send_i64 * H).view(np.uintp)
+        self.dispatch_token_recvcounts = (recv_i64 * H).view(np.uintp)
+        self.dispatch_token_sdispls = (sdisp_i64 * H).view(np.uintp)
+        self.dispatch_token_rdispls = (rdisp_i64 * H).view(np.uintp)
+
+        # Combine = dispatch with send/recv swapped; reuse underlying arrays.
+        self.combine_prob_sendcounts = self.dispatch_prob_recvcounts
+        self.combine_prob_recvcounts = self.dispatch_prob_sendcounts
+        self.combine_prob_sdispls = self.dispatch_prob_rdispls
+        self.combine_prob_rdispls = self.dispatch_prob_sdispls
+
+        self.combine_token_sendcounts = self.dispatch_token_recvcounts
+        self.combine_token_recvcounts = self.dispatch_token_sendcounts
+        self.combine_token_sdispls = self.dispatch_token_rdispls
+        self.combine_token_rdispls = self.dispatch_token_sdispls
+
+    def _init_main_slab(self) -> None:
+        """Set up the shared main slab and pre-build its tensor views.
+
+        Acquires the process-wide-shared main slab from vccl_alloc, registers
+        it on self._comm, binds self._buffer to the backing NcclBuffer, and
+        builds typed tensor views over each region declared in
+        _VCCL_BUFFER_SPECS.
+
+        The slab is a process-wide singleton: the FIRST VCCLManager
+        constructed in the process creates the pool (one slot, sized to
+        _buf_size, REG_WINDOW for symmetric-window collectives) and
+        register_for_collectives applies the window registration on
+        self._comm. Every subsequent manager finds the pool already
+        exists, hits a no-op on register_for_collectives (idempotent for
+        the same comm), and pulls the same NcclBuffer via
+        get_pool_backing — so self._buffer points at the same physical
+        slab on every manager, and tensor views are built identically
+        across managers.
+
+        Slab layout (byte offset increases left to right):
+
+            ┌────┬────┬────┬────┬────┬────┬────┬────┬────┐
+            │itf │itb │ipf │ipb │otf │otb │opf │opb │rel │
+            └────┴────┴────┴────┴────┴────┴────┴────┴────┘
+
+            itf/ipf — input token / prob (forward)     itb/ipb — input (backward)
+            otf/opf — output token / prob (forward)    otb/opb — output (backward)
+            rel     — relay scratch for ``alltoallv``
+
+        Sizes (see ``__init__``): each token slab is ``2 * token_unit``, each
+        prob slab ``2 * prob_unit``, relay ``2 * _base_buf_size`` where
+        ``_base_buf_size = token_unit + prob_unit``. Total is
+        ``_buf_size == 10 * _base_buf_size``.
+
+        The intermediate ``VcclBuffer`` wrapper for each region is local to
+        the view-building loop and discarded once ``to_tensor`` has captured
+        the raw pointer through ``CudaMemoryWrapper``; only the typed tensor
+        view is stored on ``self``.
+
+        Why sharing one slab across managers is safe (vs. each manager
+        owning its own slab as before):
+          * Every manager's _VCCL_BUFFER_SPECS produces the same per-slot
+            offsets, so all managers' input_*_tensor / output_*_tensor /
+            relay_tensor attributes alias the same memory.
+          * In a typical Megatron forward pass, only one MoE layer's
+            dispatch / combine is active at a time, so the buffers are
+            never written by two managers concurrently.
+          * Autograd ctx only saves *_bwd buffers and relay_tensor.
+            Those are scratch space — backward writes them fresh
+            (sendbuf_bwd is overwritten via copy_, recvbuf_bwd is the
+            recv target, relaybuf is internal). Cross-manager content
+            races don't apply.
+        """
+        pool_name = self._VCCL_ALLOC_POOL_MAIN_BUF
+
+        if vccl_alloc.get_pool(pool_name) is None:
+            # First manager in the process — create and register the pool.
+            # No 2-MiB rounding: the slab is consumed via VcclBuffer.to_tensor
+            # (which uses __cuda_array_interface__), not through PyTorch's
+            # caching allocator, so PyTorch's bucket sizes don't apply.
+            vccl_alloc.create_pool(
+                pool_name,
+                slot_size=self._buf_size,
+                num_slots=1,
+                register_kind=vccl_alloc.REG_WINDOW,
+            )
+        else:
+            # Subsequent manager — verify the existing slab is large enough
+            # for THIS manager's expected layout. (In normal Megatron use
+            # every MoE layer shares the same model config so this matches;
+            # the assert catches accidental misconfiguration.)
+            existing_size = vccl_alloc.get_pool_slot_size(pool_name)
+            assert existing_size >= self._buf_size, (
+                f"{self.__class__.__name__}: shared main slab too small: "
+                f"existing slot_size={existing_size}, this manager's "
+                f"_buf_size={self._buf_size}. All VCCLManager instances "
+                f"must share the same model config."
+            )
+
+        # Register the slab on our EP comm (idempotent for the same comm).
+        vccl_alloc.register_for_collectives(self._comm)
+
+        # The view-building loop below reads buf.handle / buf.device_id from
+        # this NcclBuffer, so it Just Works the same as when self._buffer
+        # came from a direct nccl.mem_alloc.
+        self._buffer = vccl_alloc.get_pool_backing(pool_name)
+        assert self._buffer is not None, (
+            f"{self.__class__.__name__}: vccl_alloc pool '{pool_name}' has "
+            f"no backing slab"
+        )
+
+        # Pre-cache a 1D typed tensor at params_dtype for each slab region
+        # so dispatch/combine can skip the per-call to_tensor() path and
+        # just slice+reshape.
+        offset = 0
+        for tensor_attr, size_attr in self._VCCL_BUFFER_SPECS:
+            size = getattr(self, size_attr)
+            buffer = VcclBuffer(self._buffer, size=size, offset=offset)
+            if "prob" in tensor_attr:
+                tensor_dtype = self._prob_dtype
+                tensor_elem_size = self._prob_element_size
+            else:
+                tensor_dtype = self._params_dtype
+                tensor_elem_size = self._element_size
+            setattr(
+                self,
+                tensor_attr,
+                buffer.to_tensor(shape=(size // tensor_elem_size,), dtype=tensor_dtype),
+            )
+            offset += size
+
+        self.log(
+            f"vccl_alloc pool '{pool_name}' ready "
+            f"(slot_size={vccl_alloc.get_pool_slot_size(pool_name)} bytes, "
+            f"num_slots={vccl_alloc.get_pool_slot_num(pool_name)}); "
+            f"main slab shared across all VCCLManager instances"
+        )
+
+    @staticmethod
+    def _round_up_to_2mib(value: int) -> int:
+        # PyTorch's CUDA caching allocator rounds requests >= 10 MiB up to a
+        # multiple of 2 MiB before they reach my_malloc. The vccl_alloc slot
+        # therefore must be at least the rounded request size; pad to the
+        # next 2 MiB so we never reject our own well-formed allocation.
+        align = 2 * 1024 * 1024
+        return ((value + align - 1) // align) * align
+
+    def _init_output_dispatch_fwd_pool_via_vccl_alloc(self) -> None:
+        """Stand up the vccl_alloc pool that backs the dispatch recvbuf slot.
+
+        This method only does the things that have to happen ONCE, before any
+        collective uses the slab:
+            1. create_pool — allocates slabs via nccl.mem_alloc. Each slot
+               is large enough to hold BOTH the dispatch prob recvbuf
+               (output_prob_fwd_buf_size bytes) AND the dispatch token
+               recvbuf (output_token_fwd_buf_size bytes), in that fixed
+               order. The 2-MiB-aligned padding is applied to the combined
+               size so PyTorch's caching layer's bucket-rounded request
+               fits the slot.
+            2. register_for_collectives — asks vccl_alloc to apply
+               ncclCommWindowRegister-equivalent registration on self._comm.
+
+        The pool is created with prebuild_slot_tensors=True, so each slot's
+        uint8 backing tensor is built once at create_pool time. dispatch()
+        then calls vccl_alloc.acquire_slot_tensor, which advances a global
+        ring cursor and views the next slot as the requested (shape, dtype).
+        compute_pool_slot_count picks num_slots from peak concurrency
+        (in-flight microbatches × MoE layers per pipeline stage), so by
+        the time the cursor wraps the prior consumer of that slot is done.
+
+        Why num_slots=compute_pool_slot_count(args) + register_kind=REG_WINDOW:
+            Each dispatch() leaves its recvbuf alive (via downstream
+            operators' autograd-saved tensors) until backward. The pool
+            must therefore hold one live slab per concurrently-live
+            recvbuf at peak: in-flight microbatches × layers per stage.
+            See compute_pool_slot_count's docstring for the derivation.
+            REG_WINDOW tells vccl_alloc to apply ncclCommWindowRegister-
+            equivalent registration on every comm passed to
+            register_for_collectives — no manual comm.register_window
+            call needed here.
+        """
+        assert self._comm is not None, (
+            f"{self.__class__.__name__}: comm must be initialized before "
+            f"output_dispatch_fwd pool setup"
+        )
+
+        pool_name = self._VCCL_ALLOC_POOL_OUTPUT_DISPATCH_FWD
+
+        # Create the pool only on first construction. If a second VCCLManager
+        # is built in the same process and a pool of this name already
+        # exists, reuse it (the pool/window are process-wide singletons).
+        # prebuild_slot_tensors=True so dispatch() can use
+        # vccl_alloc.acquire_slot_tensor — that returns the next slot's
+        # cached tensor directly (cursor++ % num_slots), skipping the
+        # caching allocator + use_mem_pool overhead on the hot path.
+        if vccl_alloc.get_pool(pool_name) is None:
+            slot_size = self._round_up_to_2mib(
+                self.output_prob_fwd_buf_size + self.output_token_fwd_buf_size
+            )
+            vccl_alloc.create_pool(
+                pool_name,
+                slot_size=slot_size,
+                num_slots=compute_pool_slot_count(get_args()),
+                register_kind=vccl_alloc.REG_WINDOW,
+                prebuild_slot_tensors=True,
+            )
+
+        # Register the slab on our EP comm. vccl_alloc walks every existing
+        # pool and applies its configured register_kind via the appropriate
+        # nccl4py path (method-on-comm for VCCL_MOE). Idempotent for the
+        # same comm.
+        vccl_alloc.register_for_collectives(self._comm)
+
+        self.log(
+            f"vccl_alloc pool '{pool_name}' ready "
+            f"(slot_size={vccl_alloc.get_pool_slot_size(pool_name)} bytes, "
+            f"num_slots={vccl_alloc.get_pool_slot_num(pool_name)}, "
+            f"prebuilt); dispatch() acquires the next slot via "
+            f"vccl_alloc.acquire_slot_tensor (cursor % num_slots)"
+        )
+
+    def __del__(self):
+        # self._free_memory()
+        # destroy_expert_model_parallel_comm()
+        pass
+
+    def _free_memory(self) -> None:
+        # Intentional no-op. self._buffer used to be owned by THIS manager
+        # (allocated directly via nccl.mem_alloc) and freeing it at __del__
+        # time was a clean teardown. With the shared-slab refactor,
+        # self._buffer is a process-wide singleton owned by vccl_alloc
+        # (see _init_main_slab); calling nccl.mem_free here would crash
+        # every other VCCLManager that shares the slab. vccl_alloc's
+        # atexit handler frees the slab once at process exit.
+        pass
+
+    def _resolve_stream_ptr(self) -> Optional[int]:
+        if self._comm_stream_ptr is not None:
+            return self._comm_stream_ptr
+        comm_stream = get_comm_stream()
+        if comm_stream is not None:
+            self._comm_stream_ptr = comm_stream.cuda_stream
+        return self._comm_stream_ptr
+
+    def dispatch(
+        self,
+        tokens: torch.Tensor,
+        probs: torch.Tensor | None,
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        """Send tokens (and probs) across the EP group via VCCL alltoallv.
+
+        Args:
+            tokens (torch.Tensor): Token tensor of shape [num_selected, hidden_size].
+                Must share storage with self.input_token_fwd_tensor.
+            probs (torch.Tensor | None): Prob tensor of shape [num_selected],
+                or None to skip the prob alltoallv. Must share storage with
+                self.input_prob_fwd_tensor when provided.
+
+        Returns:
+            (output_token, output_prob): Token tensor of shape
+                [num_recv_tokens, hidden_size] backed by the dispatch-recvbuf
+                pool slot, and the matching prob tensor of shape
+                [num_recv_tokens] (or None if probs was None).
+        """
+        # Per-call preconditions. Init-time invariants (comm/method/buffer existence)
+        # are validated once in __init__.
+        assert tokens.dtype == self._params_dtype, (
+            f"{self.__class__.__name__}: tokens dtype {tokens.dtype} "
+            f"does not match params_dtype {self._params_dtype}"
+        )
+        assert (
+            tokens.untyped_storage().data_ptr() == self._input_token_fwd_storage_ptr
+        ), (
+            f"{self.__class__.__name__}: tokens must share storage with input_token_fwd_tensor"
+        )
+        if probs is not None:
+            assert probs.dtype == self._prob_dtype, (
+                f"{self.__class__.__name__}: probs dtype {probs.dtype} "
+                f"does not match prob_dtype {self._prob_dtype}"
+            )
+            assert (
+                probs.untyped_storage().data_ptr() == self._input_prob_fwd_storage_ptr
+            ), (
+                f"{self.__class__.__name__}: probs must share storage with input_prob_fwd_tensor"
+            )
+
+        N, H = tokens.shape  # [num_selected_tokens, hidden_size]
+
+        # Populated once per forward by setup_metadata().
+        expected_num_send_tokens = self.expected_num_dispatch_send_tokens
+        expected_num_recv_tokens = self.expected_num_dispatch_recv_tokens
+        assert N == expected_num_send_tokens, (
+            f"send token number wrong, expected {expected_num_send_tokens} but got {N}"
+        )
+        input_token_tensor_len = expected_num_send_tokens * H
+        input_prob_tensor_len = expected_num_send_tokens if probs is not None else 0
+        output_token_tensor_len = expected_num_recv_tokens * H
+        output_prob_tensor_len = expected_num_recv_tokens if probs is not None else 0
+
+        # Acquire the next free slot from the dispatch-recvbuf pool
+        # (window-registered, prebuild_slot_tensors=True). vccl_alloc raises
+        # RuntimeError if every slot is held — that's the signal that a
+        # release_slot call is missing or peak concurrency exceeds num_slots.
+        #
+        # The slot is a single uint8 byte tensor; we slice it BYTE-WISE into
+        # an independently-typed view per region. Today both regions still
+        # use self._params_dtype (so prob_dtype == token_dtype), but the
+        # layout is byte-addressed, so changing only one dtype later is a
+        # one-line edit on prob_dtype / token_dtype below.
+        #
+        # Reserved-region byte layout in the slot:
+        #   [0                          : output_prob_fwd_buf_size)          -> prob region
+        #   [output_prob_fwd_buf_size   : prob_size + token_size)            -> token region
+        # The per-call USED prefix of each region is `<count> * <itemsize>`.
+        pool_name = self._VCCL_ALLOC_POOL_OUTPUT_DISPATCH_FWD
+        self.output_dispatch_fwd_byte_tensor = vccl_alloc.acquire_slot_byte_tensor(
+            pool_name
+        )
+        # Bind the byte tensor to a local so the release closure on the
+        # token alltoall captures THIS dispatch's slot, not whatever
+        # self.output_dispatch_fwd_byte_tensor will be reassigned to on the
+        # next dispatch call.
+        _slot_byte_tensor_for_release = self.output_dispatch_fwd_byte_tensor
+        stream_ptr = self._resolve_stream_ptr()
+
+        # ====================================================================
+        # Prob alltoallv — issued AS EARLY AS POSSIBLE.
+        # All token-side compute is intentionally deferred below so the prob
+        # alltoallv launch isn't gated on it (saves ~3-5us of view ops).
+        # ====================================================================
+        if probs is not None:
+            prob_dtype = self._prob_dtype
+            prob_itemsize = prob_dtype.itemsize
+            prob_used_bytes = output_prob_tensor_len * prob_itemsize
+            output_prob_tensor = (
+                _slot_byte_tensor_for_release[:prob_used_bytes]
+                .view(prob_dtype)
+                .view(expected_num_recv_tokens)
+            )
+            input_prob_bwd_tensor = self.input_prob_bwd_tensor[
+                :output_prob_tensor_len
+            ].view(expected_num_recv_tokens)
+            output_prob_bwd_tensor = self.output_prob_bwd_tensor[
+                :input_prob_tensor_len
+            ].view(expected_num_send_tokens)
+
+            # Total extra latency from VcclAlltoAllv.apply to forward is ~36us.
+            output_prob = VcclAlltoAllv.apply(
+                VcclAlltoAllvMeta(
+                    self._comm,
+                    self.dispatch_prob_sendcounts,
+                    self.dispatch_prob_sdispls,
+                    self.dispatch_prob_recvcounts,
+                    self.dispatch_prob_rdispls,
+                    self._prob_nccl_dtype,
+                    stream_ptr,
+                    input_prob_bwd_tensor,
+                    output_prob_bwd_tensor,
+                    self.relay_tensor,
+                    None,
+                ),
+                probs,
+                output_prob_tensor,
+            )
+        else:
+            output_prob = None
+
+        # ====================================================================
+        # Token alltoallv — all token-side view construction happens here,
+        # AFTER the prob alltoallv has been queued. The release_slot callback
+        # is attached to this alltoall's backward: TE GroupedLinear's saved
+        # token recvbuf is drained inside expert_bwd (which runs upstream of
+        # token_alltoall_bwd in the autograd graph), so by the time
+        # VcclAlltoAllv.backward finishes here nothing still needs the slot's
+        # storage. The lambda closes over _slot_byte_tensor_for_release, so
+        # each in-flight dispatch carries its own release callback.
+        # ====================================================================
+        token_dtype = self._params_dtype
+        token_itemsize = token_dtype.itemsize
+        token_used_bytes = output_token_tensor_len * token_itemsize
+        token_byte_offset = self.output_prob_fwd_buf_size
+        output_token_tensor = (
+            _slot_byte_tensor_for_release[
+                token_byte_offset : token_byte_offset + token_used_bytes
+            ]
+            .view(token_dtype)
+            .view(expected_num_recv_tokens, H)
+        )
+        input_token_bwd_tensor = self.input_token_bwd_tensor[
+            :output_token_tensor_len
+        ].view(expected_num_recv_tokens, H)
+        output_token_bwd_tensor = self.output_token_bwd_tensor[
+            :input_token_tensor_len
+        ].view(expected_num_send_tokens, H)
+
+        output_token = VcclAlltoAllv.apply(
+            VcclAlltoAllvMeta(
+                self._comm,
+                self.dispatch_token_sendcounts,
+                self.dispatch_token_sdispls,
+                self.dispatch_token_recvcounts,
+                self.dispatch_token_rdispls,
+                self._nccl_dtype,
+                stream_ptr,
+                input_token_bwd_tensor,
+                output_token_bwd_tensor,
+                self.relay_tensor,
+                lambda: vccl_alloc.release_slot(
+                    pool_name, _slot_byte_tensor_for_release,
+                ),
+            ),
+            tokens,
+            output_token_tensor,
+        )
+
+        return output_token, output_prob
+
+    def combine(self, tokens: torch.Tensor) -> torch.Tensor:
+        """Gather expert outputs back across the EP group via VCCL alltoallv.
+
+        Args:
+            tokens (torch.Tensor): Token tensor of shape [num_tokens, hidden_size].
+                Must share storage with self.input_token_fwd_tensor.
+
+        Returns:
+            torch.Tensor: Combined token tensor of shape
+                [num_send_tokens, hidden_size] backed by
+                self.output_token_fwd_tensor.
+        """
+        # Per-call preconditions. Init-time invariants are validated once in __init__.
+        assert tokens.dtype == self._params_dtype, (
+            f"{self.__class__.__name__}: tokens dtype {tokens.dtype} "
+            f"does not match params_dtype {self._params_dtype}"
+        )
+        assert (
+            tokens.untyped_storage().data_ptr() == self._input_token_fwd_storage_ptr
+        ), (
+            f"{self.__class__.__name__}: tokens must share storage with input_token_fwd_tensor"
+        )
+
+        N, H = tokens.shape
+        expected_num_send_tokens = self.expected_num_combine_send_tokens
+        expected_num_recv_tokens = self.expected_num_combine_recv_tokens
+        assert N == expected_num_send_tokens, (
+            f"send token number wrong, expected {expected_num_send_tokens} but got {N}"
+        )
+        input_tensor_len = expected_num_send_tokens * H
+        output_tensor_len = expected_num_recv_tokens * H
+        input_tensor = tokens
+        output_tensor = self.output_token_fwd_tensor[:output_tensor_len].view(
+            expected_num_recv_tokens, H
+        )
+        input_bwd_tensor = self.input_token_bwd_tensor[:output_tensor_len].view(
+            expected_num_recv_tokens, H
+        )
+        output_bwd_tensor = self.output_token_bwd_tensor[:input_tensor_len].view(
+            expected_num_send_tokens, H
+        )
+        output_ = VcclAlltoAllv.apply(
+            VcclAlltoAllvMeta(
+                self._comm,
+                self.combine_token_sendcounts,
+                self.combine_token_sdispls,
+                self.combine_token_recvcounts,
+                self.combine_token_rdispls,
+                self._nccl_dtype,
+                self._resolve_stream_ptr(),
+                input_bwd_tensor,
+                output_bwd_tensor,
+                self.relay_tensor,
+                None,
+            ),
+            input_tensor,
+            output_tensor,
+        )
+
+        return output_
+
+
+# ============================================================================
+# VCCL-specific reduce-scatter that hijacks output into input_token_fwd_tensor
+# ============================================================================
+
+def _vccl_reduce_scatter_along_first_dim(
+    input_, group, fwd_out_buffer=None, input_split_sizes=None
+):
+    """Reduce-scatter with optional output hijack into fwd_out_buffer.
+
+    This is a copy of megatron.core.tensor_parallel.mappings._reduce_scatter_along_first_dim
+    with the addition of writing the result into fwd_out_buffer when provided.
+
+    Note: This function assumes world_size > 1. The caller (vccl_reduce_scatter_to_sequence_parallel_region)
+    is only invoked when tp_size > 1.
+
+    Args:
+        input_ (torch.Tensor): The input tensor to be reduce-scattered.
+        group: The process group for reduce-scatter.
+        fwd_out_buffer (torch.Tensor, optional): If provided, the output is written here.
+        input_split_sizes (List[int], optional): A list specifying the sizes of
+            the input splits along the first dimension for each rank.
+    """
+    assert group is not None, "group should not be None"
+    world_size = group.size()
+    assert world_size > 1, "This function requires world_size > 1"
+
+    if input_split_sizes is None:
+        dim_size = list(input_.size())
+        assert (
+            dim_size[0] % world_size == 0
+        ), "First dimension of the tensor should be divisible by tensor parallel size"
+
+        dim_size[0] = dim_size[0] // world_size
+
+        if fwd_out_buffer is not None:
+            output = fwd_out_buffer.view(input_.dtype)[:dim_size[0] * dim_size[1]].view(dim_size)
+        else:
+            output = torch.empty(dim_size, dtype=input_.dtype, device=torch.cuda.current_device())
+        dist.reduce_scatter(output, input_.contiguous(), group=group)
+    else:
+        rank = group.rank()
+        input_tensor_list = list(torch.split(input_, input_split_sizes, dim=0))
+
+        if fwd_out_buffer is not None:
+            output = fwd_out_buffer.view(input_.dtype)[:input_tensor_list[rank].numel()].view(
+                input_tensor_list[rank].shape
+            )
+        else:
+            output = torch.empty_like(input_tensor_list[rank])
+        dist.reduce_scatter(output, input_tensor_list, group=group)
+    return output
+
+
+class _VcclReduceScatterToSequenceParallelRegion(torch.autograd.Function):
+    """Reduce scatter with VCCL output hijack for combine AlltoAll sendbuf."""
+
+    @staticmethod
+    def forward(ctx, input_, group, fwd_out_buffer, input_split_sizes=None):
+        """Forward function. Hijacks output into fwd_out_buffer."""
+        ctx.group = group
+        ctx.input_split_sizes = input_split_sizes
+        ctx.input_shape = input_.shape
+        return _vccl_reduce_scatter_along_first_dim(
+            input_, group, fwd_out_buffer=fwd_out_buffer, input_split_sizes=input_split_sizes
+        )
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        """Backward function."""
+        from megatron.core.tensor_parallel.mappings import _gather_along_first_dim
+        input_split_sizes = ctx.input_split_sizes
+        return (
+            _gather_along_first_dim(grad_output, ctx.group, input_split_sizes),
+            None,
+            None,
+            None,
+        )
+
+
+def vccl_reduce_scatter_to_sequence_parallel_region(
+    input_, group=None, fwd_out_buffer=None, input_split_sizes=None
+):
+    """VCCL version of reduce_scatter_to_sequence_parallel_region.
+
+    This function hijacks the output into fwd_out_buffer (input_token_fwd_tensor)
+    so that the combine AlltoAll can read from it directly.
+
+    Args:
+        input_ (torch.Tensor): Input tensor.
+        group: Process group for reduce-scatter.
+        fwd_out_buffer (torch.Tensor): Buffer to write the output into.
+        input_split_sizes (List[int], optional): Split sizes for uneven distribution.
+    """
+    group = get_tensor_model_parallel_group_if_none(group)
+    return _VcclReduceScatterToSequenceParallelRegion.apply(
+        input_, group, fwd_out_buffer, input_split_sizes
+    )
+
+
+def _vccl_gather_along_first_dim(
+    input_, group, bwd_out_buffer=None, output_split_sizes=None
+):
+    """Gather with optional backward hijack into bwd_out_buffer.
+
+    This is a copy of megatron.core.tensor_parallel.mappings._gather_along_first_dim
+    with the addition of hijacking the backward's reduce-scatter output into bwd_out_buffer.
+
+    Note: This function assumes world_size > 1.
+
+    Args:
+        input_ (torch.Tensor): The input tensor to be gathered.
+        group: The process group for all-gather.
+        bwd_out_buffer (torch.Tensor, optional): If provided, backward's reduce-scatter
+            output is written here.
+        output_split_sizes (List[int], optional): Split sizes for uneven distribution.
+    """
+    assert group is not None, "group should not be None"
+    world_size = group.size()
+    assert world_size > 1, "This function requires world_size > 1"
+
+    dim_size = list(input_.size())
+    if output_split_sizes is None:
+        dim_size[0] = dim_size[0] * world_size
+
+        output = torch.empty(dim_size, dtype=input_.dtype, device=torch.cuda.current_device())
+        torch.distributed.all_gather_into_tensor(output, input_.contiguous(), group=group)
+    else:
+        dim_size[0] = sum(output_split_sizes)
+        output = torch.empty(dim_size, dtype=input_.dtype, device=torch.cuda.current_device())
+        output_tensor_list = list(torch.split(output, output_split_sizes, dim=0))
+        torch.distributed.all_gather(output_tensor_list, input_.contiguous(), group=group)
+
+    return output
+
+
+class _VcclGatherFromSequenceParallelRegion(torch.autograd.Function):
+    """Gather with VCCL backward hijack for dispatch AlltoAll sendbuf_bwd."""
+
+    @staticmethod
+    def forward(ctx, input_, group, bwd_out_buffer, output_split_sizes=None):
+        """Forward function. All-gather along first dim."""
+        ctx.group = group
+        ctx.output_split_sizes = output_split_sizes
+        ctx.bwd_out_buffer = bwd_out_buffer
+        ctx.input_shape = input_.shape
+        return _vccl_gather_along_first_dim(
+            input_, group, bwd_out_buffer=bwd_out_buffer, output_split_sizes=output_split_sizes
+        )
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        """Backward function. Reduce-scatter with hijack into bwd_out_buffer."""
+        return (
+            _vccl_reduce_scatter_along_first_dim(
+                grad_output, ctx.group,
+                fwd_out_buffer=ctx.bwd_out_buffer,
+                input_split_sizes=ctx.output_split_sizes
+            ),
+            None,
+            None,
+            None,
+        )
+
+
+def vccl_gather_from_sequence_parallel_region(
+    input_, group=None, bwd_out_buffer=None, output_split_sizes=None
+):
+    """VCCL version of gather_from_sequence_parallel_region.
+
+    This function hijacks the backward's reduce-scatter output into bwd_out_buffer
+    (input_token_bwd_tensor) so that dispatch's AlltoAll backward can read from it directly.
+
+    Args:
+        input_ (torch.Tensor): Input tensor.
+        group: Process group for all-gather.
+        bwd_out_buffer (torch.Tensor): Buffer to write the backward output into.
+        output_split_sizes (List[int], optional): Split sizes for uneven distribution.
+    """
+    group = get_tensor_model_parallel_group_if_none(group)
+    return _VcclGatherFromSequenceParallelRegion.apply(
+        input_, group, bwd_out_buffer, output_split_sizes
+    )
+
+
+class VcclMoEAlltoAllvTokenDispatcher(MoEAlltoAllTokenDispatcher):
+    """
+    AlltoAllv-based token dispatcher of VCCL.
+
+    The workflow of AlltoAll token dispatcher is as follows:
+    (1) preprocess: calculate necessary metadata for communication and permute
+    (2) dispatch process: permute tokens
+    (3) token dispatch: A2A(EP)
+    (4) dispatch postprocess: AG(TP)->sort_chunk(if num_local_experts>1)
+    (5) combine preprocess: sort_chunk(if num_local_experts>1)->RS(TP)
+    (6) token combine: A2A(EP)
+    (7) combine postprocess: unpermute tokens
+    """
+    provides_out_tensor = True
+
+    def __init__(
+        self,
+        num_local_experts: int,
+        local_expert_indices: List[int],
+        config: TransformerConfig,
+        pg_collection: Optional[ProcessGroupCollection] = None,
+    ) -> None:
+        """
+        Initialize the AlltoAll token dispatcher.
+
+        Args:
+            num_local_experts (int): Number of local experts on the current device.
+            local_expert_indices (List[int]): Indices of local experts on the current device.
+            config (TransformerConfig): Configuration for the transformer model.
+            pg_collection (ProcessGroupCollection, optional): Process groups for MoE operations.
+        """
+
+        super().__init__(
+            num_local_experts=num_local_experts,
+            local_expert_indices=local_expert_indices,
+            config=config,
+            pg_collection=pg_collection,
+        )
+        # initialize VCCLManager
+        self._manager = VCCLManager(config=config, pg_collection=pg_collection)
+        self.num_global_tokens_per_expert: Optional[torch.Tensor] = None
+
+
+    def preprocess(self, routing_map: torch.Tensor) -> torch.Tensor:
+        """
+        Preprocesses the token routing map for All-to-Allv communication and token permutation.
+
+        This method computes the number of tokens assigned to each expert based on the routing_map.
+        It also initializes necessary data structures for All-to-All communication, such as input
+        and output splits, and the mapping between global tokens and local experts. This method
+        should not call any DtoH data copying due to performance consideration. The necessary DtoH
+        copies are made on the `self.cuda_dtoh_stream` at `self.cuda_dtoh_point`.
+
+        Args:
+            routing_map (torch.Tensor): The mapping of tokens to experts.
+
+        Returns:
+            A tensor with the number of tokens for each local expert.
+        """
+        if self.drop_and_pad:
+            # Drop and pad the input to capacity.
+            num_tokens = routing_map.size(0) * self.config.moe_router_topk
+            self.capacity = get_capacity(
+                num_tokens=num_tokens,
+                num_experts=self.num_experts,
+                capacity_factor=self.moe_expert_capacity_factor,
+            )
+            self.num_out_tokens = self.capacity * self.num_experts
+            # [num_local_experts], number of tokens processed by each expert.
+            num_tokens_per_local_expert = torch.full(
+                (self.num_local_experts,),
+                self.capacity * self.tp_size * self.ep_size,
+                dtype=torch.long,
+            )
+            # [tp_size * ep_size, num_local_experts]. Represents the number of tokens sent
+            # to each local expert by all ranks.
+            self.num_global_tokens_per_local_expert = torch.full(
+                (self.num_experts * self.tp_size,),
+                self.capacity,
+                dtype=torch.long,
+                device=self.permute_idx_device,
+            )
+            return num_tokens_per_local_expert
+
+        # [num_experts], number of tokens assigned to each expert from the current rank's input.
+        num_local_tokens_per_expert = routing_map.sum(dim=0).long()
+
+        if (
+            self.config.moe_expert_capacity_factor is not None
+            or self.config.moe_router_padding_for_quantization
+        ):
+            # When using token dropping or router padding, output size is dynamic.
+            # Need to sync output size GPU->CPU before allocating output buffer
+            self.num_out_tokens = num_local_tokens_per_expert.sum()
+            self._maybe_update_cuda_sync_point("before_permutation_1")
+        else:
+            # For dropless training, output size is static (num_tokens * topk)
+            # No explicit sync needed
+            self.num_out_tokens = routing_map.size(0) * self.config.moe_router_topk
+        if self.ep_size > 1 or self.tp_size > 1:
+            # ===================================================
+            # Calculate input_splits, output_splits for alltoall/allgather in variable size.
+            # ===================================================
+            # [ep_size]. Represents the number of tokens sent by the current rank to other
+            # EP ranks.
+            self.input_splits = num_local_tokens_per_expert.reshape(
+                self.ep_size, self.num_local_experts
+            ).sum(axis=1)
+            # Gather the global distribution of tokens across ranks.
+            # num_global_tokens_per_expert represents the number of tokens sent to each
+            # expert by all ranks.
+            # [tp_size, ep_size, num_experts]
+            self.num_global_tokens_per_expert = (
+                gather_from_sequence_parallel_region(
+                    num_local_tokens_per_expert, group=self.tp_ep_group
+                )
+                .reshape(self.ep_size, self.tp_size, self.num_experts)
+                .transpose(0, 1)
+            )
+
+            # [tp_size, ep_size, num_experts] -> [tp_size, ep_size, num_local_experts]
+            num_global_tokens_per_local_expert = self.num_global_tokens_per_expert[
+                :, :, self.local_expert_indices[0] : self.local_expert_indices[-1] + 1
+            ].contiguous()
+            # [tp_size, ep_size, num_local_experts] -> [tp_size, ep_size]
+            num_global_tokens_per_rank = num_global_tokens_per_local_expert.sum(axis=2)
+            # [tp_size, ep_size] -> [ep_size]
+            # self.output_splits represents the number of tokens received by the current rank
+            # from other EP rank.
+            self.output_splits = num_global_tokens_per_rank[self.tp_rank]
+            # [tp_size, ep_size] -> [tp_size]
+            # self.output_splits_tp represents the number of tokens received by the current
+            # rank from other TP rank.
+            self.output_splits_tp = num_global_tokens_per_rank.sum(axis=1)
+            # [tp_size, ep_size, num_local_experts] -> [num_local_experts]
+            num_tokens_per_local_expert = num_global_tokens_per_local_expert.sum(
+                dim=(0, 1)
+            )
+
+            # A synchronization is needed before expert parallel AlltoAll communication
+            # to get the `input_splits` and `output_splits` CPU values.
+            self._maybe_update_cuda_sync_point("before_ep_alltoall")
+        else:
+            num_global_tokens_per_local_expert = num_local_tokens_per_expert.reshape(
+                self.num_experts
+            )
+            num_tokens_per_local_expert = num_local_tokens_per_expert
+
+            # A synchronization is needed before the returns
+            # to get the `num_tokens_per_local_expert` CPU value.
+            self._maybe_update_cuda_sync_point("before_finish")
+
+        if self.num_local_experts > 1:
+            # [tp_size * ep_size, num_local_experts]. Represents the number of tokens sent
+            # to each local expert by all ranks.
+            self.num_global_tokens_per_local_expert = (
+                num_global_tokens_per_local_expert.view(-1, self.num_local_experts)
+            )
+            if not self.config.moe_permute_fusion:
+                # A synchronization is needed before permutation 2
+                # to get the `num_global_tokens_per_local_expert` CPU value.
+                self._maybe_update_cuda_sync_point("before_permutation_2")
+
+        assert (
+            self.cuda_sync_point_priority[self.cuda_dtoh_point]
+            <= self.cuda_sync_point_priority[self.cuda_sync_point]
+        ), "cuda_sync_point must be after cuda_dtoh_point."
+        return num_tokens_per_local_expert
+
+    def dispatch_preprocess(
+        self, hidden_states: torch.Tensor, routing_map: torch.Tensor, probs: torch.Tensor
+    ):
+        """Prepares hidden states and probabilities for dispatch.
+
+        This method reshapes the hidden states, computes communication metadata,
+        and permutes the tokens and probabilities before the All-to-All communication.
+
+        Args:
+            hidden_states (torch.Tensor): Input token embeddings.
+            routing_map (torch.Tensor): The mapping of tokens to experts.
+            probs (torch.Tensor): Routing probabilities.
+
+        Returns:
+            A tuple of permuted hidden states and probabilities.
+        """
+        # Preprocess: Get the metadata for communication, permutation and computation operations.
+        self.hidden_shape = hidden_states.shape
+        self.probs = probs
+        self.routing_map = routing_map
+        assert probs.dim() == 2, "Expected 2D tensor for probs"
+        assert routing_map.dim() == 2, "Expected 2D tensor for token2expert mask"
+        assert routing_map.dtype == torch.bool, "Expected bool tensor for mask"
+        hidden_states = hidden_states.view(-1, self.hidden_shape[-1])
+
+        if self.config.moe_router_padding_for_quantization:
+            pad_multiple = get_align_size_for_quantization(self.config)
+            if is_experimental_enabled() and self.config.moe_permute_fusion:
+                self.routing_map = fused_pad_routing_map(self.routing_map, pad_multiple)
+            else:
+                self.routing_map = pad_routing_map(self.routing_map, pad_multiple)
+        self.tokens_per_expert = self.preprocess(self.routing_map)
+
+        if self.shared_experts is not None:
+            self.shared_experts.pre_forward_comm(hidden_states.view(self.hidden_shape))
+
+        # Permutation 1: input to AlltoAll input
+        self.tokens_per_expert = self._maybe_dtoh_and_synchronize(
+            "before_permutation_1", self.tokens_per_expert
+        )
+        self.hidden_shape_before_permute = hidden_states.shape
+        input_token_tensor = None
+        input_prob_tensor = None
+        if not self.config.moe_permute_fusion:
+            assert self._manager.input_token_fwd_tensor is not None, (
+                f"{self.__class__.__name__}: manager input token tensor not initialized"
+            )
+            assert self._manager.input_prob_fwd_tensor is not None, (
+                f"{self.__class__.__name__}: manager input prob tensor not initialized"
+            )
+            num_permuted_tokens = self.num_out_tokens
+            if num_permuted_tokens is None:
+                num_permuted_tokens = self.routing_map.sum()
+            if torch.is_tensor(num_permuted_tokens):
+                num_permuted_tokens = int(num_permuted_tokens.item())
+            else:
+                num_permuted_tokens = int(num_permuted_tokens)
+            hidden_size = hidden_states.size(1)
+            num_input_token_elements = num_permuted_tokens * hidden_size
+            manager_input_token_tensor = self._manager.input_token_fwd_tensor.view(
+                hidden_states.dtype
+            )
+            assert num_input_token_elements <= manager_input_token_tensor.numel(), (
+                f"{self.__class__.__name__}: manager input token buffer too small, "
+                f"need {num_input_token_elements} elements but only have "
+                f"{manager_input_token_tensor.numel()}"
+            )
+            input_token_tensor = manager_input_token_tensor[
+                :num_input_token_elements
+            ].view(num_permuted_tokens, hidden_size)
+            manager_input_prob_tensor = self._manager.input_prob_fwd_tensor.view(
+                probs.dtype
+            )
+            assert num_permuted_tokens <= manager_input_prob_tensor.numel(), (
+                f"{self.__class__.__name__}: manager input prob buffer too small, "
+                f"need {num_permuted_tokens} elements but only have "
+                f"{manager_input_prob_tensor.numel()}"
+            )
+            input_prob_tensor = manager_input_prob_tensor[:num_permuted_tokens]
+        (
+            input_token_tensor,
+            input_prob_tensor,
+            self.reversed_local_input_permutation_mapping,
+        ) = permute(
+            hidden_states,
+            self.routing_map,
+            probs=probs,
+            num_out_tokens=self.num_out_tokens,
+            fused=self.config.moe_permute_fusion,
+            drop_and_pad=self.drop_and_pad,
+            input_token_tensor=input_token_tensor,
+            input_prob_tensor=input_prob_tensor,
+        )
+        return input_token_tensor, input_prob_tensor
+
+    def token_dispatch(self, permutated_local_input_tokens, permuted_probs):
+        """
+        Perform all-to-allv communication for dispatching tokens.
+
+        Args:
+            permutated_local_input_tokens (torch.Tensor): Pre-permuted input tokens.
+            permuted_probs (torch.Tensor): Pre-permuted probabilities.
+
+        Returns:
+            A tuple of tokens and probabilities after All-to-All.
+        """
+        # Perform expert parallel AlltoAll communication
+        self.tokens_per_expert = self._maybe_dtoh_and_synchronize(
+            "before_ep_alltoall", self.tokens_per_expert
+        )
+        if self.num_global_tokens_per_expert is not None:
+            self._manager.setup_metadata(
+                num_global_tokens_per_expert=self.num_global_tokens_per_expert
+            )
+            self.num_global_tokens_per_expert = None
+        global_input_tokens, global_probs = self._manager.dispatch(
+            permutated_local_input_tokens,
+            permuted_probs,
+        )
+        return global_input_tokens, global_probs
+
+    def dispatch_postprocess(self, global_input_tokens, global_probs):
+        """Post-processes tokens after All-to-All communication.
+
+        This involves an All-Gather in the tensor parallel dimension and sorting
+        tokens by expert if there are multiple local experts.
+
+        Grad hijack strategy:
+        - When tp_size > 1: hijack in gather's backward (reduce_scatter) for both token and prob
+        - When tp_size == 1 and num_local_experts > 1: hijack in sort's backward
+        - When tp_size == 1 and num_local_experts == 1: no hijack needed
+
+        Args:
+            global_input_tokens (torch.Tensor): Tokens after All-to-All.
+            global_probs (torch.Tensor): Probabilities after All-to-All.
+
+        Returns:
+            A tuple of processed tokens, token counts per expert, and processed probabilities.
+        """
+        if self.shared_experts is not None:
+            self.shared_experts.linear_fc1_forward_and_act(global_input_tokens)
+
+        if self.tp_size > 1:
+            if self.output_splits_tp is None:
+                output_split_sizes = None
+            else:
+                output_split_sizes = self.output_splits_tp.tolist()
+
+            # Compute bwd_out_buffer size for token grad hijack
+            # In backward (reduce-scatter), the output size is the input size / tp_size
+            # For uneven split, it's output_split_sizes[rank]
+            N_gather = global_input_tokens.shape[0]
+            H_gather = global_input_tokens.shape[1]
+            if output_split_sizes is not None:
+                # Uneven split: each rank gets output_split_sizes[rank] tokens
+                rank = self.tp_group.rank()
+                rs_out_N = output_split_sizes[rank]
+            else:
+                # Even split: each rank gets N_gather / tp_size tokens
+                rs_out_N = N_gather // self.tp_size
+
+            # Token grad hijack buffer - size should be reduce-scatter output size
+            token_bwd_out_buffer = self._manager.input_token_bwd_tensor.view(
+                global_input_tokens.dtype
+            )[:rs_out_N * H_gather].view(rs_out_N, H_gather)
+
+            # Prob grad hijack buffer - same size as token (without hidden dim)
+            prob_bwd_out_buffer = self._manager.input_prob_bwd_tensor.view(
+                global_probs.dtype
+            )[:rs_out_N]
+
+            # Use vccl_gather_from_sequence_parallel_region to hijack backward
+            global_input_tokens = vccl_gather_from_sequence_parallel_region(
+                global_input_tokens, group=self.tp_group,
+                bwd_out_buffer=token_bwd_out_buffer,
+                output_split_sizes=output_split_sizes,
+            )
+            global_probs = vccl_gather_from_sequence_parallel_region(
+                global_probs, group=self.tp_group,
+                bwd_out_buffer=prob_bwd_out_buffer,
+                output_split_sizes=output_split_sizes,
+            )
+
+        # Permutation 2: Sort tokens by local expert.
+        self.tokens_per_expert = self._maybe_dtoh_and_synchronize(
+            "before_permutation_2", self.tokens_per_expert
+        )
+        if self.num_local_experts > 1:
+            if self.tp_size > 1:
+                # When tp_size > 1, don't hijack in sort step.
+                # The grad hijack already happened in gather's backward above.
+                if self.drop_and_pad:
+                    N, H = global_input_tokens.shape
+                    A = self.tp_size * self.ep_size
+                    B = self.num_local_experts
+                    C = self.capacity
+
+                    global_input_tokens = DiffTransposeChunksOut.apply(
+                        global_input_tokens, A, B, C, None, None,
+                    )
+
+                    if global_probs is not None:
+                        global_probs = DiffTransposeChunksOut.apply(
+                            global_probs, A, B, C, None, None,
+                        )
+                else:
+                    global_input_tokens, global_probs = vccl_sort_chunks_by_idxs(
+                        global_input_tokens,
+                        self.num_global_tokens_per_local_expert.ravel(),
+                        self.sort_input_by_local_experts,
+                        probs=global_probs,
+                        grad_out_buffer=None,
+                        prob_grad_out_buffer=None,
+                        fused=self.config.moe_permute_fusion,
+                    )
+            else:
+                # When tp_size == 1, hijack in sort step.
+                if self.drop_and_pad:
+                    N, H = global_input_tokens.shape
+                    combine_input_tensor_len = N * H
+                    A = self.tp_size * self.ep_size
+                    B = self.num_local_experts
+                    C = self.capacity
+
+                    sort_grad_out_buffer = self._manager.input_token_bwd_tensor.view(
+                        global_input_tokens.dtype
+                    )[:combine_input_tensor_len].view(N, H)
+
+                    global_input_tokens = DiffTransposeChunksOut.apply(
+                        global_input_tokens, A, B, C, sort_grad_out_buffer, None,
+                    )
+
+                    if global_probs is not None:
+                        sort_prob_grad_out_buffer = self._manager.input_prob_bwd_tensor.view(
+                            global_probs.dtype
+                        )[:N]
+                        global_probs = DiffTransposeChunksOut.apply(
+                            global_probs, A, B, C, sort_prob_grad_out_buffer, None,
+                        )
+                else:
+                    N, H = global_input_tokens.shape
+                    combine_input_tensor_len = N * H
+
+                    sort_grad_out_buffer = self._manager.input_token_bwd_tensor.view(
+                        global_input_tokens.dtype
+                    )[:combine_input_tensor_len].view(N, H)
+
+                    sort_prob_grad_out_buffer = None
+                    if global_probs is not None:
+                        sort_prob_grad_out_buffer = self._manager.input_prob_bwd_tensor.view(
+                            global_probs.dtype
+                        )[:N]
+
+                    global_input_tokens, global_probs = vccl_sort_chunks_by_idxs(
+                        global_input_tokens,
+                        self.num_global_tokens_per_local_expert.ravel(),
+                        self.sort_input_by_local_experts,
+                        probs=global_probs,
+                        grad_out_buffer=sort_grad_out_buffer,
+                        prob_grad_out_buffer=sort_prob_grad_out_buffer,
+                        fused=self.config.moe_permute_fusion,
+                    )
+
+        tokens_per_expert = self._maybe_dtoh_and_synchronize(
+            "before_finish", self.tokens_per_expert
+        )
+        self.tokens_per_expert = None
+        N, H = global_input_tokens.shape
+        combine_input_tensor_len = N * H
+
+        if self.num_local_experts > 1 or self.tp_size > 1:
+            # When sort/transpose is applied (num_local_experts > 1) or
+            # reduce_scatter is needed (tp_size > 1), return None for both so that:
+            # - fc2 allocates its own output (combine_preprocess will unsort and/or
+            #   reduce_scatter into input_token_fwd_tensor)
+            # - fc1 allocates its own grad (sort backward writes the unsorted grad
+            #   into input_token_bwd_tensor via grad_out_buffer)
+            combine_input_tensor = None
+            dispatch_dgard_tensor = None
+        else:
+            # No sort step and no reduce_scatter: fc2 writes directly into
+            # input_token_fwd_tensor (combine sendbuf), fc1 backward writes
+            # directly into input_token_bwd_tensor (dispatch sendbuf_bwd).
+            combine_input_tensor = self._manager.input_token_fwd_tensor.view(
+                global_input_tokens.dtype
+            )[:combine_input_tensor_len].view(N, H)
+            dispatch_dgard_tensor = self._manager.input_token_bwd_tensor.view(
+                global_input_tokens.dtype
+            )[:combine_input_tensor_len].view(N, H)
+
+        return global_input_tokens, tokens_per_expert, global_probs, combine_input_tensor, dispatch_dgard_tensor
+
+    def combine_preprocess(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        """Unsort expert outputs and write directly into input_token_fwd_tensor
+        (combine AlltoAll sendbuf).
+
+        For num_local_experts > 1, reverses the sort done in dispatch_postprocess.
+        The forward writes into input_token_fwd_tensor via fwd_out_buffer so that
+        token_combine's AlltoAll can read from it directly without an extra copy.
+
+        When tp_size > 1 and num_local_experts > 1, we defer the hijack to the
+        reduce_scatter step (instead of the sort step) so that the final output
+        after reduce_scatter is written directly into input_token_fwd_tensor.
+        """
+        if self.num_local_experts > 1:
+            N, H = hidden_states.shape
+            combine_input_tensor_len = N * H
+
+            if self.tp_size > 1:
+                # When tp_size > 1, don't hijack in sort step.
+                # The hijack will happen in reduce_scatter below.
+                if self.drop_and_pad:
+                    A = self.tp_size * self.ep_size
+                    B = self.num_local_experts
+                    C = self.capacity
+                    hidden_states = DiffTransposeChunksOut.apply(
+                        hidden_states, B, A, C, None, None,
+                    )
+                else:
+                    hidden_states, _ = vccl_sort_chunks_by_idxs(
+                        hidden_states,
+                        self.num_global_tokens_per_local_expert.T.ravel(),
+                        self.restore_output_by_local_experts,
+                        fwd_out_buffer=None,
+                        fused=self.config.moe_permute_fusion,
+                    )
+            else:
+                # When tp_size == 1, hijack in sort step as before.
+                fwd_out_buffer = self._manager.input_token_fwd_tensor.view(
+                    hidden_states.dtype
+                )[:combine_input_tensor_len].view(N, H)
+
+                if self.drop_and_pad:
+                    A = self.tp_size * self.ep_size
+                    B = self.num_local_experts
+                    C = self.capacity
+                    hidden_states = DiffTransposeChunksOut.apply(
+                        hidden_states, B, A, C, None, fwd_out_buffer,
+                    )
+                else:
+                    hidden_states, _ = vccl_sort_chunks_by_idxs(
+                        hidden_states,
+                        self.num_global_tokens_per_local_expert.T.ravel(),
+                        self.restore_output_by_local_experts,
+                        fwd_out_buffer=fwd_out_buffer,
+                        fused=self.config.moe_permute_fusion,
+                    )
+
+        if self.tp_size > 1:
+            if self.output_splits_tp is None:
+                input_split_sizes = None
+            else:
+                input_split_sizes = self.output_splits_tp.tolist()
+
+            # Prepare fwd_out_buffer for reduce_scatter hijack.
+            # After reduce_scatter, the output size is reduced by tp_size.
+            N_rs, H_rs = hidden_states.shape
+            if input_split_sizes is not None:
+                # Uneven split: output size is input_split_sizes[rank] * H
+                rank = self.tp_group.rank()
+                out_N = input_split_sizes[rank]
+            else:
+                # Even split: output size is N / tp_size
+                out_N = N_rs // self.tp_size
+
+            # Use probs.dtype to match the dtype of input_ passed to reduce_scatter
+            fwd_out_buffer = self._manager.input_token_fwd_tensor.view(
+                self.probs.dtype
+            )[:out_N * H_rs].view(out_N, H_rs)
+
+            # Use vccl_reduce_scatter_to_sequence_parallel_region to hijack output
+            hidden_states = vccl_reduce_scatter_to_sequence_parallel_region(
+                hidden_states.to(self.probs.dtype),
+                group=self.tp_group,
+                fwd_out_buffer=fwd_out_buffer,
+                input_split_sizes=input_split_sizes,
+            ).to(hidden_states.dtype)
+
+        return hidden_states
+
+    def token_combine(
+        self,
+        hidden_states: torch.Tensor,
+        async_finish: bool = True,
+        allocate_on_comm_stream: bool = True,
+    ):
+        permutated_local_input_tokens = self._manager.combine(hidden_states)
+        return permutated_local_input_tokens
+
+    def combine_postprocess(self, permutated_local_input_tokens):
+        """Finalizes token reconstruction with un-permutation and reshaping.
+
+        This method un-permutes the tokens back to their original order,
+        reshapes the tensor to its original shape, and adds the shared
+        expert output if enabled.
+
+        Args:
+            permutated_local_input_tokens (torch.Tensor): Permuted hidden states from token combine.
+
+        Returns:
+            The final MoE layer output reshaped to its original dimensions.
+        """
+        if self.shared_experts is not None:
+            self.shared_experts.linear_fc2_forward(permutated_local_input_tokens)
+            self.shared_experts.post_forward_comm()
+
+        N, H = permutated_local_input_tokens.shape
+        combine_grad_tensor_len = N * H
+        combine_grad_tensor = self._manager.input_token_bwd_tensor.view(permutated_local_input_tokens.dtype)
+        combine_grad_tensor = combine_grad_tensor[:combine_grad_tensor_len].view(N, H)
+
+        # Unpermutation 1: AlltoAllv output to output
+        output = unpermute(
+            permutated_local_input_tokens,
+            self.reversed_local_input_permutation_mapping,
+            restore_shape=self.hidden_shape_before_permute,
+            routing_map=self.routing_map,
+            fused=self.config.moe_permute_fusion,
+            drop_and_pad=self.drop_and_pad,
+            input_token_tensor = combine_grad_tensor,
+        )
+
+        # Reshape the output tensor
+        output = output.view(self.hidden_shape)
+
+        # Add shared experts output
+        if self.shared_experts is not None:
+            shared_expert_output = self.shared_experts.get_output()
+            output += shared_expert_output
+        return output
