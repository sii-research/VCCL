+class VcclAlltoAllvMeta:
+    """Opaque-to-pytree container for everything VcclAlltoAllv needs that
+    isn't an autograd-tracked tensor.
+
+    `torch.autograd.Function.apply` runs `unwrap_dead_wrappers` (in
+    torch/_functorch/utils.py) over every input arg before calling
+    forward — that's a pytree walk plus a per-tensor wrapper check. The
+    cost scales with the number of leaves. Bundling everything that's
+    NOT sendbuf/recvbuf into a single `__slots__` class gives pytree one
+    opaque leaf to skip; only the two visible tensor args stay positional
+    on `Function.apply`.
+
+    This struct also caches values that backward would otherwise
+    re-fetch every call:
+      * the bwd-direction count/displ aliases (just the fwd arrays with
+        send/recv swapped — pre-bound here so backward doesn't have to
+        construct anything);
+      * sendbuf_bwd's data_ptr (used in the bwd fast-path comparison);
+      * relaybuf's data_ptr / numel (constant for the slab's lifetime).
+
+    Don't register this class with pytree; the whole point is that
+    pytree treats it as a single leaf.
+    """
+
+    __slots__ = (
+        "comm",
+        "dtype",
+        "stream_ptr",
+        # Forward-direction counts/displs (sendbuf -> recvbuf).
+        "sendcounts",
+        "sdispls",
+        "recvcounts",
+        "rdispls",
+        # Backward-direction counts/displs (sendbuf_bwd -> recvbuf_bwd).
+        # Aliases of the fwd arrays with send/recv swapped — no copies.
+        "bwd_sendcounts",
+        "bwd_sdispls",
+        "bwd_recvcounts",
+        "bwd_rdispls",
+        # Backward scratch buffers, bundled here so ctx.meta = meta is
+        # the only ctx write at forward time.
+        "sendbuf_bwd",
+        "recvbuf_bwd",
+        # Cached pointers/counts. relay_* is constant for the buffer's
+        # lifetime; sendbuf_bwd_ptr is constant because sendbuf_bwd is a
+        # pre-allocated slab tensor.
+        "sendbuf_bwd_ptr",
+        "relay_ptr",
+        "relay_count",
+        # Slot-release callback fired once after bwd alltoallv is queued.
+        "on_backward_complete",
+    )
+
+    def __init__(
+        self,
+        comm: nccl.Communicator,
+        sendcounts: np.ndarray,
+        sdispls: np.ndarray,
+        recvcounts: np.ndarray,
+        rdispls: np.ndarray,
+        dtype: nccl.NcclDataType,
+        stream_ptr: Optional[int],
+        sendbuf_bwd: torch.Tensor,
+        recvbuf_bwd: torch.Tensor,
+        relaybuf: Optional[torch.Tensor],
+        on_backward_complete: Optional[Callable[[], None]],
+    ):
+        self.comm = comm
+        self.dtype = dtype
+        self.stream_ptr = stream_ptr
+        self.sendcounts = sendcounts
+        self.sdispls = sdispls
+        self.recvcounts = recvcounts
+        self.rdispls = rdispls
+        # bwd direction = fwd with send/recv swapped; aliases, no copies.
+        self.bwd_sendcounts = recvcounts
+        self.bwd_sdispls = rdispls
+        self.bwd_recvcounts = sendcounts
+        self.bwd_rdispls = sdispls
+        self.sendbuf_bwd = sendbuf_bwd
+        self.recvbuf_bwd = recvbuf_bwd
+        self.sendbuf_bwd_ptr = (
+            sendbuf_bwd.data_ptr() if sendbuf_bwd is not None else 0
+        )
+        if relaybuf is not None:
+            self.relay_ptr = relaybuf.data_ptr()
+            self.relay_count = relaybuf.numel()
+        else:
+            self.relay_ptr = 0
+            self.relay_count = 0
+        self.on_backward_complete = on_backward_complete
+
