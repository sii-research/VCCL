+class CudaMemoryWrapper:
+    """Wrapper for CUDA memory buffer."""
+
+    def __init__(self, ptr: int, shape: tuple | int, dtype: str | torch.dtype):
+        """Initialize CUDA memory wrapper.
+
+        Args:
+            ptr: cuda memory address pointer
+            shape: tuple, e.g. (1024,)
+            dtype: string of data type, e.g. "float32"
+        """
+        if not isinstance(ptr, int):
+            self.ptr = int(ptr)
+        else:
+            self.ptr = ptr
+
+        if isinstance(shape, int):
+            self.shape = (shape,)
+        elif isinstance(shape, tuple):
+            self.shape = shape
+        else:
+            raise ValueError(f"Unsupported shape type: {type(shape)}")
+
+        if isinstance(dtype, str):
+            self.typestr = DTYPESTR_TO_TYPESTR.get(dtype)
+            self.torch_dtype = DTYPESTR_TO_TORCHTYPE.get(dtype)
+            if self.typestr is None:
+                raise ValueError(f"Unsupported dtype: {dtype}")
+        elif isinstance(dtype, torch.dtype):
+            self.typestr = TORCHTYPE_TO_TYPESTR.get(dtype)
+            self.torch_dtype = dtype
+            if self.typestr is None:
+                raise ValueError(f"Unsupported dtype: {dtype}")
+        else:
+            raise ValueError(f"Unsupported dtype: {dtype}")
+
+    @property
+    def __cuda_array_interface__(self):
+        return {
+            "version": 3,
+            "shape": self.shape,
+            "typestr": self.typestr,
+            "data": (self.ptr, False),
+            "strides": None,
+        }
+
+
+class VcclBuffer:
+    def __init__(self, buf: nccl.NcclBuffer, size: int, offset: int = 0):
+        """Initialize a VcclBuffer object.
+
+        Args:
+            buf: NcclBuffer object
+            size: size in bytes
+            offset: offset in bytes (default: 0)
+        """
+        self._raw_ptr = buf.handle
+        self._offset = offset
+        self._device_id = buf.device_id
+        self._size = size
+
+    def to_tensor(self, shape: tuple, dtype: str) -> torch.Tensor:
+        """Convert NCCL4Py NcclBuffer to PyTorch tensor.
+
+        Args:
+            shape: tuple, e.g. (1024,)
+            dtype: string of data type, e.g. "float32"
+
+        Returns:
+            PyTorch tensor
+        """
+        wrapper_str = CudaMemoryWrapper(self._raw_ptr + self._offset, shape, dtype)
+        tensor = torch.as_tensor(
+            wrapper_str, device=f"cuda:{self._device_id}"
+        )  # nccl buffer belongs to a GPU
+        tensor = tensor.view(wrapper_str.torch_dtype)
+        return tensor
+
