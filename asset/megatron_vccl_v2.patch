@@ -0,0 +1,394 @@
+"""demo.py — exercise the vccl_alloc public API.
+
+What's covered (every public symbol exported via __init__.py except the
+NCCL-communicator-dependent paths):
+
+    Lifecycle:    create_pool, destroy_pool
+    Routing:      in_pool
+    Getters:      get_pool, get_pool_backing, get_pool_slot_size,
+                  get_pool_slot_num, get_pool_slot_addr, list_pools
+    Diagnostics:  is_enabled, live_count, peak_live
+    Constants:    REG_BUFFER, REG_WINDOW, REG_NONE,
+                  DEFAULT_SLOT_SIZE, DEFAULT_NUM_SLOTS, LOCAL_RANK
+
+What's NOT covered: register_for_collectives / deregister_collectives.
+Those need a real NCCL Communicator, which requires a distributed launch.
+They are exercised end-to-end by VCCLManager in real Megatron runs.
+
+Prerequisites:
+    * libvccl_arena_allocator.so built next to vccl_alloc/setup.py:
+        nvcc -Xcompiler -fPIC -shared -std=c++17 \
+             -o libvccl_arena_allocator.so vccl_arena_allocator.cu
+    * nccl4py importable as `nccl.core` (set VCCL_MOE_PATH if needed).
+    * A working CUDA device.
+
+Run:
+    python -m vccl_alloc.demo            # from vccl-megatron/
+    python vccl_alloc/demo.py            # ditto, sys.path patched below
+"""
+
+# Path setup so `python vccl_alloc/demo.py` works without -m.
+import os, sys
+_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
+_PARENT = os.path.dirname(_THIS_DIR)
+if _PARENT not in sys.path:
+    sys.path.insert(0, _PARENT)
+
+import torch
+import vccl_alloc
+
+
+# ---------------------------------------------------------------------------
+# Banner & invariants
+# ---------------------------------------------------------------------------
+print("=" * 72)
+print(f"is_enabled()       = {vccl_alloc.is_enabled()}")
+print(f"LOCAL_RANK         = {vccl_alloc.LOCAL_RANK}")
+print(f"DEFAULT_SLOT_SIZE  = {vccl_alloc.DEFAULT_SLOT_SIZE} bytes "
+      f"({vccl_alloc.DEFAULT_SLOT_SIZE >> 20} MiB)")
+print(f"DEFAULT_NUM_SLOTS  = {vccl_alloc.DEFAULT_NUM_SLOTS}")
+print(f"REG_BUFFER / REG_WINDOW / REG_NONE = "
+      f"{vccl_alloc.REG_BUFFER!r} / {vccl_alloc.REG_WINDOW!r} / {vccl_alloc.REG_NONE!r}")
+print("=" * 72)
+
+if not vccl_alloc.is_enabled():
+    print("\nVCCL_ALLOC_DISABLE is set; demo cannot exercise the allocator. Exit.")
+    sys.exit(0)
+
+# Use REG_NONE everywhere so the demo doesn't need a NCCL communicator.
+KIND = vccl_alloc.REG_NONE
+
+
+def _slot_index(addr: int, base: int, slot_size: int) -> int:
+    return (addr - base) // slot_size
+
+
+def _section(title: str) -> None:
+    print(f"\n=== {title} ===")
+
+
+# ---------------------------------------------------------------------------
+# Test 1: create_pool + in_pool route allocations into the slab.
+# ---------------------------------------------------------------------------
+_section("Test 1: create_pool + in_pool route allocations into the slab")
+SLOT_SIZE = 4 * 1024 * 1024     # 4 MiB
+NUM_SLOTS = 8
+ELEMS_PER_SLOT = SLOT_SIZE // 4  # float32
+
+mp_alpha = vccl_alloc.create_pool(
+    "alpha", slot_size=SLOT_SIZE, num_slots=NUM_SLOTS, register_kind=KIND,
+)
+print(f"  create_pool('alpha') -> MemPool {mp_alpha!r}")
+
+slab_lo = vccl_alloc.get_pool_slot_addr("alpha", 0)
+slab_hi = slab_lo + SLOT_SIZE * NUM_SLOTS
+print(f"  slab range: 0x{slab_lo:x} .. 0x{slab_hi:x} "
+      f"({(SLOT_SIZE * NUM_SLOTS) >> 20} MiB)")
+
+with vccl_alloc.in_pool("alpha"):
+    t = torch.empty(ELEMS_PER_SLOT, dtype=torch.float32, device='cuda')
+    assert slab_lo <= t.data_ptr() < slab_hi, "tensor not inside the slab"
+    print(f"  t.data_ptr()=0x{t.data_ptr():x} "
+          f"(slot={_slot_index(t.data_ptr(), slab_lo, SLOT_SIZE)})")
+    del t
+torch.cuda.synchronize()
+
+
+# ---------------------------------------------------------------------------
+# Test 2: getter API agrees with create_pool arguments and computed offsets.
+# ---------------------------------------------------------------------------
+_section("Test 2: getter API")
+print(f"  list_pools() -> {vccl_alloc.list_pools()}")
+
+assert vccl_alloc.get_pool("alpha") is mp_alpha
+assert vccl_alloc.get_pool("nope") is None
+assert vccl_alloc.get_pool_slot_size("alpha") == SLOT_SIZE
+assert vccl_alloc.get_pool_slot_size("nope") == 0
+assert vccl_alloc.get_pool_slot_num("alpha") == NUM_SLOTS
+assert vccl_alloc.get_pool_slot_num("nope") == 0
+assert vccl_alloc.get_pool_backing("alpha") is not None
+assert vccl_alloc.get_pool_backing("nope") is None
+print(f"  get_pool / get_pool_slot_size / get_pool_slot_num / "
+      f"get_pool_backing return expected values for known and unknown names")
+
+for i in range(NUM_SLOTS):
+    expected = slab_lo + i * SLOT_SIZE
+    actual = vccl_alloc.get_pool_slot_addr("alpha", i)
+    assert actual == expected, f"slot {i}: 0x{actual:x} != 0x{expected:x}"
+print(f"  get_pool_slot_addr matches base + idx * slot_size for all "
+      f"{NUM_SLOTS} slots")
+
+assert vccl_alloc.get_pool_slot_addr("alpha", -1) == 0, "negative idx must return 0"
+assert vccl_alloc.get_pool_slot_addr("alpha", NUM_SLOTS) == 0, \
+    "out-of-range idx must return 0"
+assert vccl_alloc.get_pool_slot_addr("nope", 0) == 0, "unknown pool must return 0"
+print(f"  get_pool_slot_addr returns 0 for negative / out-of-range / unknown")
+
+
+# ---------------------------------------------------------------------------
+# Test 3: ring cursor advances forward; freed middle slot reused only on wrap.
+# ---------------------------------------------------------------------------
+_section("Test 3: ring slot allocation pattern")
+with vccl_alloc.in_pool("alpha"):
+    ts = [torch.empty(ELEMS_PER_SLOT, dtype=torch.float32, device='cuda')
+          for _ in range(4)]
+    slot_ids = [_slot_index(t.data_ptr(), slab_lo, SLOT_SIZE) for t in ts]
+    print(f"  4 fresh allocs -> slots {slot_ids}")
+    print(f"  freeing ts[1] (slot {slot_ids[1]})")
+    ts[1] = None
+    torch.cuda.synchronize()
+    extra = torch.empty(ELEMS_PER_SLOT, dtype=torch.float32, device='cuda')
+    extra_idx = _slot_index(extra.data_ptr(), slab_lo, SLOT_SIZE)
+    print(f"  next alloc -> slot {extra_idx}  "
+          f"(forward of slot {slot_ids[-1]}, NOT slot {slot_ids[1]})")
+    del ts, extra
+torch.cuda.synchronize()
+
+
+# ---------------------------------------------------------------------------
+# Test 4: live_count tracks held tensors, peak_live is monotonic.
+# ---------------------------------------------------------------------------
+_section("Test 4: live_count / peak_live diagnostics")
+with vccl_alloc.in_pool("alpha"):
+    held = [torch.empty(ELEMS_PER_SLOT, dtype=torch.float32, device='cuda')
+            for _ in range(3)]
+    live_now = vccl_alloc.live_count("alpha")
+    peak_now = vccl_alloc.peak_live("alpha")
+    print(f"  with 3 tensors held: live={live_now}, peak={peak_now}")
+    assert live_now >= 3, "live_count must be >= number of currently-held tensors"
+    assert peak_now >= live_now, "peak_live must be >= live_count"
+    del held
+torch.cuda.synchronize()
+print(f"  after release:       live={vccl_alloc.live_count('alpha')}, "
+      f"peak={vccl_alloc.peak_live('alpha')}")
+print(f"  unknown pool: live_count={vccl_alloc.live_count('nope')}, "
+      f"peak_live={vccl_alloc.peak_live('nope')} (both -1 by contract)")
+assert vccl_alloc.live_count("nope") == -1
+assert vccl_alloc.peak_live("nope") == -1
+
+
+# ---------------------------------------------------------------------------
+# Test 5: slot exhaustion → OOM at slot count.
+# ---------------------------------------------------------------------------
+_section("Test 5: slot exhaustion raises OOM")
+with vccl_alloc.in_pool("alpha"):
+    big = []
+    try:
+        for _ in range(NUM_SLOTS * 4):
+            big.append(torch.empty(ELEMS_PER_SLOT, dtype=torch.float32, device='cuda'))
+        print(f"  UNEXPECTED: allocated all {len(big)} without OOM")
+    except (torch.cuda.OutOfMemoryError, RuntimeError) as e:
+        print(f"  OOM after {len(big)} tensors  "
+              f"(num_slots={vccl_alloc.get_pool_slot_num('alpha')}, "
+              f"peak_live={vccl_alloc.peak_live('alpha')})")
+    del big
+torch.cuda.synchronize()
+
+
+# ---------------------------------------------------------------------------
+# Test 6: storage.resize_(0) and resize_(N) round-trip stay in the slab.
+# ---------------------------------------------------------------------------
+_section("Test 6: storage.resize_(0) and resize_(N) round-trip")
+with vccl_alloc.in_pool("alpha"):
+    t = torch.empty(ELEMS_PER_SLOT, dtype=torch.float32, device='cuda')
+    p1 = t.data_ptr()
+    print(f"  initial:          ptr=0x{p1:x} nbytes={t.untyped_storage().nbytes()}")
+    t.untyped_storage().resize_(0)
+    print(f"  after resize_(0): nbytes={t.untyped_storage().nbytes()}")
+    t.untyped_storage().resize_(SLOT_SIZE)
+    p2 = t.data_ptr()
+    inside = slab_lo <= p2 < slab_hi
+    print(f"  after resize_(N): ptr=0x{p2:x} nbytes={t.untyped_storage().nbytes()} "
+          f"inside_slab={inside}")
+    assert inside, "resized storage left the slab"
+    del t
+torch.cuda.synchronize()
+
+
+# ---------------------------------------------------------------------------
+# Test 7: oversized request rejected by my_malloc → propagates as OOM.
+# ---------------------------------------------------------------------------
+_section("Test 7: oversized request rejected")
+with vccl_alloc.in_pool("alpha"):
+    too_many_elems = SLOT_SIZE  # SLOT_SIZE * 4 bytes — far larger than slot_size
+    try:
+        too_big = torch.empty(too_many_elems, dtype=torch.float32, device='cuda')
+        print(f"  UNEXPECTED: oversized allocation ({too_many_elems * 4 >> 20} MiB) "
+              f"succeeded at ptr=0x{too_big.data_ptr():x}")
+        del too_big
+    except (torch.cuda.OutOfMemoryError, RuntimeError) as e:
+        print(f"  OK rejected: {type(e).__name__}: {str(e).splitlines()[0]}")
+torch.cuda.synchronize()
+
+
+# ---------------------------------------------------------------------------
+# Test 8: in_pool on an unknown name raises KeyError.
+# ---------------------------------------------------------------------------
+_section("Test 8: in_pool('unknown') raises KeyError")
+try:
+    with vccl_alloc.in_pool("does_not_exist"):
+        torch.empty(1, device='cuda')
+    print("  UNEXPECTED: in_pool('does_not_exist') accepted")
+except KeyError as e:
+    print(f"  OK: {e}")
+
+
+# ---------------------------------------------------------------------------
+# Test 9: multiple pools coexist with different slot sizes / different slabs.
+# ---------------------------------------------------------------------------
+_section("Test 9: multiple pools coexist")
+mp_beta = vccl_alloc.create_pool(
+    "beta",  slot_size=2 * 1024 * 1024, num_slots=4, register_kind=KIND,
+)
+mp_gamma = vccl_alloc.create_pool(
+    "gamma", slot_size=8 * 1024 * 1024, num_slots=2, register_kind=KIND,
+)
+print(f"  list_pools() -> {vccl_alloc.list_pools()}")
+print(f"  beta:  slot_size={vccl_alloc.get_pool_slot_size('beta')} "
+      f"num_slots={vccl_alloc.get_pool_slot_num('beta')}")
+print(f"  gamma: slot_size={vccl_alloc.get_pool_slot_size('gamma')} "
+      f"num_slots={vccl_alloc.get_pool_slot_num('gamma')}")
+
+a0 = vccl_alloc.get_pool_slot_addr("alpha", 0)
+b0 = vccl_alloc.get_pool_slot_addr("beta", 0)
+g0 = vccl_alloc.get_pool_slot_addr("gamma", 0)
+print(f"  alpha[0]=0x{a0:x}  beta[0]=0x{b0:x}  gamma[0]=0x{g0:x}")
+assert a0 != b0 and a0 != g0 and b0 != g0, \
+    "different pools must have non-overlapping slabs"
+
+# Allocate in beta and gamma to confirm in_pool routes correctly.
+with vccl_alloc.in_pool("beta"):
+    tb = torch.empty(vccl_alloc.get_pool_slot_size("beta") // 4,
+                     dtype=torch.float32, device='cuda')
+    assert b0 <= tb.data_ptr() < b0 + 2 * 1024 * 1024 * 4, \
+        "beta tensor not in beta's slab"
+    print(f"  beta tensor:  ptr=0x{tb.data_ptr():x} (in beta's slab)")
+    del tb
+with vccl_alloc.in_pool("gamma"):
+    tg = torch.empty(vccl_alloc.get_pool_slot_size("gamma") // 4,
+                     dtype=torch.float32, device='cuda')
+    assert g0 <= tg.data_ptr() < g0 + 8 * 1024 * 1024 * 2, \
+        "gamma tensor not in gamma's slab"
+    print(f"  gamma tensor: ptr=0x{tg.data_ptr():x} (in gamma's slab)")
+    del tg
+torch.cuda.synchronize()
+
+
+# ---------------------------------------------------------------------------
+# Test 10: duplicate create_pool raises ValueError.
+# ---------------------------------------------------------------------------
+_section("Test 10: duplicate create_pool raises ValueError")
+try:
+    vccl_alloc.create_pool("alpha", register_kind=KIND)
+    print("  UNEXPECTED: duplicate create_pool('alpha') succeeded")
+except ValueError as e:
+    print(f"  OK: {e}")
+
+
+# ---------------------------------------------------------------------------
+# Test 11: register_kind values are validated.
+# ---------------------------------------------------------------------------
+_section("Test 11: invalid register_kind raises ValueError")
+try:
+    vccl_alloc.create_pool("delta", register_kind="not_a_real_kind")
+    print("  UNEXPECTED: invalid register_kind accepted")
+except ValueError as e:
+    print(f"  OK: {e}")
+
+
+# ---------------------------------------------------------------------------
+# Test 12: destroy_pool releases bookkeeping; unknown name is a no-op.
+# ---------------------------------------------------------------------------
+_section("Test 12: destroy_pool")
+print(f"  before destroy: list_pools = {vccl_alloc.list_pools()}")
+vccl_alloc.destroy_pool("beta")
+vccl_alloc.destroy_pool("gamma")
+print(f"  after destroy:  list_pools = {vccl_alloc.list_pools()}")
+assert vccl_alloc.get_pool("beta") is None
+assert vccl_alloc.get_pool("gamma") is None
+print(f"  destroy_pool('does_not_exist') is a no-op:")
+vccl_alloc.destroy_pool("does_not_exist")  # must not raise
+
+
+# ---------------------------------------------------------------------------
+# Test 13: zero-overhead slot tensors (prebuild_slot_tensors=True path).
+#   - get_slot_byte_tensor returns the same Python object on every call.
+#   - Each slot's tensor.data_ptr() equals get_pool_slot_addr(idx).
+#   - Writing through a slot tensor is observable through a viewed shape/dtype
+#     tensor over the same slot (proves they alias the same memory).
+#   - get_slot_tensor with shape/dtype produces a correctly-shaped view.
+#   - Out-of-range and oversized requests raise.
+#   - get_slot_byte_tensor against a non-prebuilt pool raises RuntimeError.
+# ---------------------------------------------------------------------------
+_section("Test 13: zero-overhead slot tensors (prebuild_slot_tensors=True)")
+
+PREBUILT_NUM_SLOTS = 4
+PREBUILT_SLOT_SIZE = 4 * 1024 * 1024
+mp_prebuilt = vccl_alloc.create_pool(
+    "prebuilt", slot_size=PREBUILT_SLOT_SIZE, num_slots=PREBUILT_NUM_SLOTS,
+    register_kind=KIND, prebuild_slot_tensors=True,
+)
+print(f"  create_pool('prebuilt', prebuild_slot_tensors=True) -> {mp_prebuilt!r}")
+
+for i in range(PREBUILT_NUM_SLOTS):
+    bt = vccl_alloc.get_slot_byte_tensor("prebuilt", i)
+    expected = vccl_alloc.get_pool_slot_addr("prebuilt", i)
+    assert bt.data_ptr() == expected, \
+        f"slot {i}: tensor 0x{bt.data_ptr():x} != expected 0x{expected:x}"
+    assert bt.dtype == torch.uint8 and bt.numel() == PREBUILT_SLOT_SIZE
+    # Identity: same Python object each call (no allocation, just a lookup).
+    assert vccl_alloc.get_slot_byte_tensor("prebuilt", i) is bt
+print(f"  byte tensor for each of {PREBUILT_NUM_SLOTS} slots aligned with slot "
+      f"addr; identity-stable across calls")
+
+# Aliasing: write via byte tensor, read via typed view.
+bt0 = vccl_alloc.get_slot_byte_tensor("prebuilt", 0)
+bt0.fill_(0x3F)  # uint8 0x3F repeated everywhere
+typed = vccl_alloc.get_slot_tensor("prebuilt", 0, shape=(4, 8), dtype=torch.float32)
+assert typed.shape == (4, 8) and typed.dtype == torch.float32
+# 0x3F3F3F3F as float32 ≈ 0.7460941
+assert typed.data_ptr() == bt0.data_ptr(), "typed view doesn't alias byte tensor"
+val = typed[0, 0].item()
+print(f"  byte fill_(0x3F) visible through float32 view: {val:.7f} (expected ~0.746)")
+
+# Oversized request rejected.
+try:
+    vccl_alloc.get_slot_tensor(
+        "prebuilt", 0, shape=(5 * 1024 * 1024 // 4,), dtype=torch.float32,
+    )
+    print("  UNEXPECTED: oversized get_slot_tensor accepted")
+except ValueError as e:
+    print(f"  OK oversized rejected: {type(e).__name__}: {str(e).splitlines()[0]}")
+
+# Out-of-range slot idx rejected.
+try:
+    vccl_alloc.get_slot_byte_tensor("prebuilt", PREBUILT_NUM_SLOTS + 5)
+    print("  UNEXPECTED: out-of-range slot idx accepted")
+except IndexError as e:
+    print(f"  OK out-of-range rejected: {type(e).__name__}: {str(e).splitlines()[0]}")
+
+# Unknown pool rejected.
+try:
+    vccl_alloc.get_slot_byte_tensor("does_not_exist", 0)
+    print("  UNEXPECTED: unknown pool accepted")
+except KeyError as e:
+    print(f"  OK unknown pool rejected: {type(e).__name__}")
+
+# Non-prebuilt pool rejected with a clear RuntimeError.
+try:
+    # alpha was created without prebuild_slot_tensors=True in Test 1.
+    vccl_alloc.get_slot_byte_tensor("alpha", 0)
+    print("  UNEXPECTED: get_slot_byte_tensor on non-prebuilt pool accepted")
+except RuntimeError as e:
+    print(f"  OK non-prebuilt rejected: {type(e).__name__}: "
+          f"{str(e).splitlines()[0][:80]}...")
+
+vccl_alloc.destroy_pool("prebuilt")
+torch.cuda.synchronize()
+
+
+# ---------------------------------------------------------------------------
+print("\nAll demo tests passed.")
+print("\nNote: register_for_collectives / deregister_collectives are not")
+print("exercised here — they need a NCCL Communicator and are tested")
+print("end-to-end by VCCLManager during real distributed runs.")
