+++ b/vccl_alloc/bench_in_pool.py
@@ -0,0 +1,260 @@
+"""bench_in_pool.py — micro-benchmark the `in_pool` context manager AND the
+zero-overhead slot-tensor path that bypasses it.
+
+Why this script exists:
+    torch.profiler instruments the C++ ATen dispatcher and CUDA runtime; pure-
+    Python `__enter__`/`__exit__` overhead never appears as a profiler event.
+    So if you compare a generator-based @contextmanager `in_pool` against a
+    class-based one with `torch.profiler`, you'll see no difference even when
+    real wall-clock has shifted by 10-30us per call. cProfile / py-spy / a
+    `timeit` loop are the right tools.
+
+What this script measures:
+    Group 1 — empty-`with` baselines (lower bound for any context-manager).
+    Group 2 — `in_pool` wrapper variants (overhead with no allocation inside):
+        - CURRENT in_pool (class)        : the version vccl_alloc ships now.
+        - Generator-baseline in_pool     : a local @contextlib.contextmanager
+                                           rebuild matching the pre-commit shape;
+                                           same arena push/pop + use_mem_pool.
+    Group 3 — full tensor-creation paths (what consumers actually pay):
+        - with in_pool: torch.empty(...) : the production path.
+        - get_slot_byte_tensor           : pre-built uint8 slot tensor; just
+                                           a list lookup.
+        - get_slot_tensor(shape, dtype)  : list lookup + slice + 2 view ops.
+
+How to run:
+    cd vccl-megatron
+    python -m vccl_alloc.bench_in_pool
+    python -m vccl_alloc.bench_in_pool --iters 200000  # tighter numbers
+
+To verify commit 35717514's wrapper-only gain, run this on HEAD and again with
+`git checkout 35717514253d43fa661fdb59e55c28a1b36aab13~1 -- vccl_alloc/setup.py`;
+the "CURRENT in_pool" line should change while the rest stays roughly stable.
+"""
+
+import os, sys
+_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
+_PARENT = os.path.dirname(_THIS_DIR)
+if _PARENT not in sys.path:
+    sys.path.insert(0, _PARENT)
+
+import argparse
+import contextlib
+import gc
+import statistics
+import time
+
+import torch
+from torch.cuda import use_mem_pool
+
+import vccl_alloc
+# `_lib`, `_pools`, `_pools_lock` only exist in the enabled branch of
+# vccl_alloc.setup; import them inside main() after the is_enabled() check,
+# otherwise a VCCL_ALLOC_DISABLE run crashes on import.
+
+# Two pools: one for dynamic alloc (used by the `with in_pool: torch.empty(...)`
+# benchmark), one with prebuild_slot_tensors=True (used by get_slot_*
+# benchmarks). Both contracts are mutually exclusive per pool, so we need
+# separate pools to bench both paths in one run.
+POOL_NAME = "bench_in_pool_pool"
+PREBUILT_POOL_NAME = "bench_prebuilt_pool"
+SLOT_SIZE = 4 << 20         # 4 MiB per slot — large enough for the test shape
+NUM_SLOTS = 4
+TENSOR_SHAPE = (1024, 256)  # 256K bf16 elements = 512 KiB; well under SLOT_SIZE
+TENSOR_DTYPE = torch.bfloat16
+
+
+def _build_generator_in_pool(_lib, _pools, _pools_lock):
+    """A local @contextmanager equivalent of in_pool, matching the pre-commit shape.
+
+    Looks up the same pool dict, runs the same arena push/pop, wraps the same
+    use_mem_pool. Only the wrapper kind (generator vs class) differs from the
+    current vccl_alloc.in_pool.
+    """
+
+    @contextlib.contextmanager
+    def in_pool_gen(name: str):
+        with _pools_lock:
+            info = _pools.get(name)
+        if info is None:
+            raise KeyError(name)
+        _lib.my_alloc_push_arena(info["name_bytes"])
+        try:
+            with use_mem_pool(info["mempool"]):
+                yield
+        finally:
+            _lib.my_alloc_pop_arena()
+
+    return in_pool_gen
+
+
+def time_loop(fn, iters: int, repeats: int = 5) -> dict:
+    """Run `fn()` `iters` times, repeat `repeats` times, return per-iter stats in microseconds."""
+    samples = []
+    for _ in range(repeats):
+        gc.collect()
+        gc.disable()
+        t0 = time.perf_counter_ns()
+        for _ in range(iters):
+            fn()
+        t1 = time.perf_counter_ns()
+        gc.enable()
+        samples.append((t1 - t0) / iters / 1_000.0)  # ns -> us per iter
+    return {
+        "min_us": min(samples),
+        "median_us": statistics.median(samples),
+        "max_us": max(samples),
+        "samples_us": samples,
+    }
+
+
+def fmt(name: str, stats: dict, ref: dict | None = None) -> str:
+    line = f"  {name:<40s} median={stats['median_us']:7.3f} us  "
+    line += f"min={stats['min_us']:7.3f}  max={stats['max_us']:7.3f}"
+    if ref is not None:
+        delta = stats["median_us"] - ref["median_us"]
+        sign = "+" if delta >= 0 else ""
+        line += f"   (Δ vs current = {sign}{delta:.3f} us)"
+    return line
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--iters", type=int, default=100_000,
+                    help="iterations per repeat (default 100000)")
+    ap.add_argument("--repeats", type=int, default=5,
+                    help="repeats; report median of medians (default 5)")
+    args = ap.parse_args()
+
+    if not vccl_alloc.is_enabled():
+        print("VCCL_ALLOC_DISABLE is set; nothing to benchmark.")
+        return 0
+
+    if not torch.cuda.is_available():
+        print("CUDA not available; this benchmark needs a GPU for use_mem_pool.")
+        return 0
+
+    # Late import — these only exist in the enabled branch of vccl_alloc.setup.
+    from vccl_alloc.setup import _lib, _pools, _pools_lock
+
+    vccl_alloc.create_pool(
+        POOL_NAME, slot_size=SLOT_SIZE, num_slots=NUM_SLOTS,
+        register_kind=vccl_alloc.REG_NONE,
+    )
+    vccl_alloc.create_pool(
+        PREBUILT_POOL_NAME, slot_size=SLOT_SIZE, num_slots=NUM_SLOTS,
+        register_kind=vccl_alloc.REG_NONE,
+        prebuild_slot_tensors=True,
+    )
+
+    in_pool_class = vccl_alloc.in_pool                                       # current implementation
+    in_pool_generator = _build_generator_in_pool(_lib, _pools, _pools_lock)  # local @contextmanager rebuild
+
+    # ---- Empty-with baselines (no arena work, no use_mem_pool) ----
+    @contextlib.contextmanager
+    def empty_gen():
+        yield
+
+    class EmptyClass:
+        __slots__ = ()
+        def __enter__(self): return self
+        def __exit__(self, *a): return None
+
+    EMPTY_CLASS = EmptyClass()
+
+    def empty_with_gen():
+        with empty_gen():
+            pass
+
+    def empty_with_class():
+        with EMPTY_CLASS:
+            pass
+
+    # ---- in_pool wrapper benchmarks (no allocation inside) ----
+    def current_with():
+        with in_pool_class(POOL_NAME):
+            pass
+
+    def generator_with():
+        with in_pool_generator(POOL_NAME):
+            pass
+
+    # ---- full tensor-creation benchmarks ----
+    def with_in_pool_torch_empty():
+        with in_pool_class(POOL_NAME):
+            t = torch.empty(TENSOR_SHAPE, dtype=TENSOR_DTYPE, device='cuda')
+        del t  # ensure release fires, mirroring real use
+
+    def get_slot_byte():
+        t = vccl_alloc.get_slot_byte_tensor(PREBUILT_POOL_NAME, 0)
+        del t
+
+    def get_slot_typed():
+        t = vccl_alloc.get_slot_tensor(
+            PREBUILT_POOL_NAME, 0, TENSOR_SHAPE, TENSOR_DTYPE,
+        )
+        del t
+
+    print(f"\nin_pool wrapper micro-benchmark")
+    print(f"iters per repeat = {args.iters}    repeats = {args.repeats}")
+    print(f"pool             = '{POOL_NAME}'  (REG_NONE, no allocation inside `with`)")
+    print(f"torch            = {torch.__version__}    cuda = {torch.version.cuda}")
+    print(f"python           = {sys.version.split()[0]}")
+    print("-" * 78)
+
+    # Warmup
+    warmup_fns = (
+        empty_with_gen, empty_with_class, current_with, generator_with,
+        with_in_pool_torch_empty, get_slot_byte, get_slot_typed,
+    )
+    for fn in warmup_fns:
+        for _ in range(2_000):
+            fn()
+
+    print("Group 1 — empty-`with` baselines (lower-bound for any context-manager wrapper):")
+    s_empty_class = time_loop(empty_with_class, args.iters, args.repeats)
+    s_empty_gen   = time_loop(empty_with_gen,   args.iters, args.repeats)
+    print(fmt("empty class CM (slotted)",     s_empty_class))
+    print(fmt("empty @contextmanager",        s_empty_gen, ref=s_empty_class))
+
+    print("\nGroup 2 — in_pool wrapper-only (arena push/pop + use_mem_pool + outer wrapper):")
+    s_current   = time_loop(current_with,   args.iters, args.repeats)
+    s_generator = time_loop(generator_with, args.iters, args.repeats)
+    print(fmt("CURRENT in_pool (class)",      s_current))
+    print(fmt("Generator-baseline in_pool",   s_generator, ref=s_current))
+
+    delta = s_generator["median_us"] - s_current["median_us"]
+    pct = (delta / s_current["median_us"]) * 100 if s_current["median_us"] else 0.0
+    print(f"  Wrapper-only savings from commit 35717514: {delta:+.3f} us "
+          f"({pct:+.1f}% of current).")
+
+    print(f"\nGroup 3 — full tensor-creation paths "
+          f"(shape={TENSOR_SHAPE}, dtype={TENSOR_DTYPE}, slot={SLOT_SIZE>>10} KiB):")
+    s_with_empty = time_loop(with_in_pool_torch_empty, args.iters, args.repeats)
+    s_slot_byte  = time_loop(get_slot_byte,            args.iters, args.repeats)
+    s_slot_typed = time_loop(get_slot_typed,           args.iters, args.repeats)
+    print(fmt("with in_pool: torch.empty(...)", s_with_empty))
+    print(fmt("get_slot_byte_tensor",           s_slot_byte,  ref=s_with_empty))
+    print(fmt("get_slot_tensor(shape, dtype)",  s_slot_typed, ref=s_with_empty))
+
+    speedup_byte  = s_with_empty["median_us"] / max(s_slot_byte["median_us"],  1e-9)
+    speedup_typed = s_with_empty["median_us"] / max(s_slot_typed["median_us"], 1e-9)
+    print()
+    print(f"Speedup vs `with in_pool: torch.empty(...)`:")
+    print(f"  get_slot_byte_tensor          {speedup_byte:6.1f}x")
+    print(f"  get_slot_tensor(shape, dtype) {speedup_typed:6.1f}x")
+    print()
+    print("Interpretation:")
+    print("  - get_slot_byte_tensor is one dict lookup + one list index — should be ~0.2 us.")
+    print("  - get_slot_tensor adds slice + .view(dtype) + .view(shape) — ~1-3 us.")
+    print("  - The full `with in_pool: torch.empty(...)` is the path you replace with these.")
+    print("  - Pre-built and dynamic-alloc pools are mutually exclusive; the bench creates one")
+    print("    of each so both paths can be measured in a single run.")
+
+    vccl_alloc.destroy_pool(POOL_NAME)
+    vccl_alloc.destroy_pool(PREBUILT_POOL_NAME)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
