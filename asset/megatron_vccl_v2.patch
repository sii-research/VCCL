+"""
+vccl_alloc.setup — multi-arena (Option B) integration with mutually-exclusive
+NCCL registration kinds: buffer (zero-copy) OR window (one-sided / NVLS / SHARP).
+
+Each named pool has its own NCCL-allocated slab and its own arena inside
+libvccl_arena_allocator.so. At create_pool time, the caller chooses exactly ONE
+registration kind:
+
+    create_pool("kv_cache", slot_size=66*MiB, num_slots=64,
+                register_kind=REG_BUFFER)        # zero-copy
+
+    create_pool("nvls_buf", slot_size=66*MiB, num_slots=32,
+                register_kind=REG_WINDOW)        # NVLS / SHARP / one-sided
+
+    create_pool("scratch",  slot_size=66*MiB, num_slots=16,
+                register_kind=REG_NONE)          # no NCCL registration
+
+After init_process_group, register_for_collectives(comm) walks every pool and
+applies its single configured kind on the new comm.
+
+Tunables (env-overrideable defaults for create_pool):
+    VCCL_ALLOC_DISABLE      truthy => skip setup; in_pool() is a no-op.
+    VCCL_ALLOC_LIB          path to libvccl_arena_allocator.so (default: same dir).
+    VCCL_ALLOC_SLOT_SIZE    default bytes per slot (default 66 MiB).
+    VCCL_ALLOC_NUM_SLOTS    default number of slots (default 64).
+    VCCL_MOE_PATH           if nccl4py isn't on sys.path, prepend this dir.
+"""
+
+import atexit
+import contextlib
+import ctypes
+import ctypes.util
+import gc
+import itertools
+import os
+import sys
+import threading
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+import torch
+from torch.cuda.memory import CUDAPluggableAllocator
+from torch.cuda import MemPool, use_mem_pool
+
+
+# ---------------------------------------------------------------------------
+# Public knobs / constants
+# ---------------------------------------------------------------------------
+def _truthy(s: Optional[str]) -> bool:
+    return bool(s) and s.lower() not in ("0", "false", "no", "off", "")
+
+
+_DISABLED = _truthy(os.environ.get("VCCL_ALLOC_DISABLE"))
+LOCAL_RANK = int(os.environ.get("LOCAL_RANK", "0"))
+DEFAULT_SLOT_SIZE = int(os.environ.get("VCCL_ALLOC_SLOT_SIZE", 66 * 1024 * 1024))
+DEFAULT_NUM_SLOTS = int(os.environ.get("VCCL_ALLOC_NUM_SLOTS", 64))
+
+LIB_PATH = os.environ.get(
+    "VCCL_ALLOC_LIB",
+    os.path.join(os.path.dirname(os.path.abspath(__file__)), "libvccl_arena_allocator.so"),
+)
+
+# Registration kinds — exactly one per pool.
+REG_BUFFER = "buffer"   # ncclCommRegister / ncclCommDeregister
+REG_WINDOW = "window"   # ncclCommWindowRegister / ncclCommWindowDeregister
+REG_NONE   = "none"     # no NCCL registration at all
+_VALID_KINDS = (REG_BUFFER, REG_WINDOW, REG_NONE)
+
+
+# ---------------------------------------------------------------------------
+# Module-level singleton state.
+# ---------------------------------------------------------------------------
+_pools: Dict[str, Dict[str, Any]] = {}
+_pools_lock = threading.Lock()
+_comms_seen: List[Any] = []
+_comms_lock = threading.Lock()
+
+
+def _validate_kind(kind: str) -> str:
+    if kind not in _VALID_KINDS:
+        raise ValueError(
+            f"register_kind must be one of {_VALID_KINDS}, got {kind!r}"
+        )
+    return kind
+
+
+# ===========================================================================
+# Disabled fast path
+# ===========================================================================
+if _DISABLED:
+    print("[vccl_alloc] disabled via VCCL_ALLOC_DISABLE; pools are no-ops.")
+
+    def is_enabled() -> bool: return False
+
+    def create_pool(name: str, slot_size: Optional[int] = None,
+                    num_slots: Optional[int] = None, *,
+                    register_kind: str = REG_BUFFER,
+                    prebuild_slot_tensors: bool = False) -> None:
+        _validate_kind(register_kind)
+        return None
+
+    def destroy_pool(name: str) -> None: pass
+    def get_pool(name: str) -> None: return None
+    def get_pool_backing(name: str) -> None: return None
+    def get_pool_slot_size(name: str) -> int: return 0
+    def get_pool_slot_num(name: str) -> int: return 0
+    def get_pool_slot_addr(name: str, slot_idx: int) -> int: return 0
+    def list_pools() -> List[str]: return []
+
+    class _NoOpInPoolContext:
+        __slots__ = ()
+        def __enter__(self): return self
+        def __exit__(self, *a): return None
+
+    _NOOP_IN_POOL = _NoOpInPoolContext()
+
+    def in_pool(name: str): return _NOOP_IN_POOL
+
+    def register_for_collectives(comm: Any) -> None: pass
+    def deregister_collectives() -> None: pass
+    def live_count(name: str) -> int: return -1
+    def peak_live(name: str) -> int: return -1
+
+    def get_slot_byte_tensor(name: str, idx: int) -> "torch.Tensor":
+        raise RuntimeError("vccl_alloc disabled; slot tensors unavailable.")
+
+    def get_slot_tensor(name: str, idx: int,
+                        shape: Optional[Sequence[int]] = None,
+                        dtype: Optional["torch.dtype"] = None) -> "torch.Tensor":
+        raise RuntimeError("vccl_alloc disabled; slot tensors unavailable.")
+
+    def acquire_slot_byte_tensor(name: str) -> "torch.Tensor":
+        raise RuntimeError("vccl_alloc disabled; slot tensors unavailable.")
+
+    def acquire_slot_tensor(name: str,
+                            shape: Optional[Sequence[int]] = None,
+                            dtype: Optional["torch.dtype"] = None) -> "torch.Tensor":
+        raise RuntimeError("vccl_alloc disabled; slot tensors unavailable.")
+
+    def release_slot(name: str, tensor: "torch.Tensor") -> None:
+        raise RuntimeError("vccl_alloc disabled; slot tensors unavailable.")
+
+else:
+    # =======================================================================
+    # 1. CUDA bring-up.
+    # =======================================================================
+    torch.cuda.set_device(LOCAL_RANK)
+    torch.cuda.init()
+
+    # =======================================================================
+    # 2. Locate and import nccl4py (importable as `nccl.core`, matching the
+    #    convention used in tests/vccl/vccl_utils.py and the rest of VCCL_MOE).
+    # =======================================================================
+    _vccl_moe = os.environ.get("VCCL_MOE_PATH")
+    if _vccl_moe and os.path.isdir(_vccl_moe) and _vccl_moe not in sys.path:
+        sys.path.insert(0, _vccl_moe)
+
+    try:
+        import nccl.core as nccl  # type: ignore
+    except ImportError as e:
+        raise ImportError(
+            "vccl_alloc requires nccl4py (imported as `nccl.core`). "
+            "Set VCCL_MOE_PATH or pip-install it. "
+            "Original error: " + repr(e)
+        ) from e
+
+    def _coerce_ptr(obj: Any) -> int:
+        if isinstance(obj, int):
+            return obj
+        if isinstance(obj, ctypes.c_void_p):
+            return obj.value or 0
+        # `handle` is what VCCL_MOE's nccl4py exposes on its NcclBuffer; the
+        # other names cover other bindings.
+        for attr in ("handle", "ptr", "device_ptr", "data_ptr"):
+            if hasattr(obj, attr):
+                v = getattr(obj, attr)
+                v = v() if callable(v) else v
+                if isinstance(v, ctypes.c_void_p):
+                    return v.value or 0
+                if isinstance(v, int):
+                    return v
+        raise TypeError(
+            f"Cannot extract device pointer from {type(obj).__name__}; "
+            f"tried attributes: handle, ptr, device_ptr, data_ptr"
+        )
+
+    def _resolve_nccl(*candidates: str) -> Optional[Any]:
+        for n in candidates:
+            fn = getattr(nccl, n, None)
+            if fn is not None:
+                return fn
+        return None
+
+    _buffer_register = _resolve_nccl(
+        "comm_register", "commRegister",
+        "register_buffer", "buffer_register",
+    )
+    _buffer_deregister = _resolve_nccl(
+        "comm_deregister", "commDeregister",
+        "deregister_buffer", "buffer_deregister",
+    )
+    _window_register = _resolve_nccl(
+        "comm_window_register", "commWindowRegister",
+        "register_window",      "window_register",
+    )
+    _window_deregister = _resolve_nccl(
+        "comm_window_deregister", "commWindowDeregister",
+        "deregister_window",      "window_deregister",
+    )
+    _mem_free = _resolve_nccl("mem_free", "memFree", "free")
+
+    # nccl4py in VCCL_MOE exposes registration as METHODS on the Communicator
+    # (e.g., comm.register_window(buf_obj, flag)). The method-on-comm probe
+    # below runs at register_for_collectives time on whatever comm the
+    # caller passes in. The presence/absence of module-level functions is
+    # NOT a problem on its own — it's only a problem if a pool's
+    # register_kind has neither a module-level fn nor a method on the comm,
+    # in which case we log loudly inside _do_register so users can spot the
+    # silent failure of an actually-attempted registration.
+    _WIN_FLAG_COLL_SYMMETRIC = getattr(
+        getattr(nccl, "WindowFlag", None), "CollSymmetric", None
+    )
+
+    # Track which (kind, comm-type) combinations we've already warned about
+    # so a misconfigured nccl4py doesn't spam the log on every (pool, comm)
+    # pair.
+    _unsupported_warned: set = set()
+
+    # =======================================================================
+    # 3. Load libvccl_arena_allocator.so and declare its C entry points.
+    # =======================================================================
+    if not os.path.isfile(LIB_PATH):
+        raise FileNotFoundError(
+            f"vccl_alloc: cannot find libvccl_arena_allocator.so at {LIB_PATH}."
+        )
+
+    _RTLD_NODELETE = 0x1000
+    _lib = ctypes.CDLL(LIB_PATH, mode=os.RTLD_LAZY | _RTLD_NODELETE)
+
+    _lib.my_alloc_create_arena.argtypes = [
+        ctypes.c_char_p, ctypes.c_void_p, ctypes.c_size_t,
+        ctypes.c_int, ctypes.c_int, ctypes.c_int,
+    ]
+    _lib.my_alloc_create_arena.restype = ctypes.c_int
+    _lib.my_alloc_destroy_arena.argtypes = [ctypes.c_char_p]
+    _lib.my_alloc_destroy_arena.restype = ctypes.c_int
+    _lib.my_alloc_shutdown.argtypes = []
+    _lib.my_alloc_shutdown.restype = None
+    _lib.my_alloc_push_arena.argtypes = [ctypes.c_char_p]
+    _lib.my_alloc_push_arena.restype = None
+    _lib.my_alloc_pop_arena.argtypes = []
+    _lib.my_alloc_pop_arena.restype = None
+    _lib.my_alloc_arena_live_count.argtypes = [ctypes.c_char_p]
+    _lib.my_alloc_arena_live_count.restype = ctypes.c_int
+    _lib.my_alloc_arena_peak_live.argtypes = [ctypes.c_char_p]
+    _lib.my_alloc_arena_peak_live.restype = ctypes.c_int
+
+    _my_alloc = CUDAPluggableAllocator(LIB_PATH, "my_malloc", "my_free")
+
+    def is_enabled() -> bool: return True
+
+    # =======================================================================
+    # 3b. Helper: cache torch.dtype -> itemsize, so get_slot_tensor doesn't
+    # have to allocate a temporary tensor on every call to compute size.
+    # =======================================================================
+    _DTYPE_ITEMSIZE: Dict["torch.dtype", int] = {}
+
+    def _itemsize(dtype: "torch.dtype") -> int:
+        sz = _DTYPE_ITEMSIZE.get(dtype)
+        if sz is None:
+            sz = torch.empty((), dtype=dtype).element_size()
+            _DTYPE_ITEMSIZE[dtype] = sz
+        return sz
+
+    # =======================================================================
+    # 4. Registration helpers — one kind per pool.
+    # =======================================================================
+    def _try_call(fn, *arg_variants) -> bool:
+        for args in arg_variants:
+            try:
+                fn(*args)
+                return True
+            except TypeError:
+                continue
+            except Exception as e:
+                print(f"[vccl_alloc] {fn} args={args}: {e!r}")
+                return False
+        print(f"[vccl_alloc] {fn} no signature variant matched")
+        return False
+
+    def _do_register(kind: str, comm: Any, slab_obj: Any,
+                     ptr: int, size: int) -> Tuple[bool, Any]:
+        """Apply the chosen registration kind. Returns (success, handle).
+
+        Tries method-on-comm first (used by VCCL_MOE's nccl4py, which exposes
+        registration as comm.register_window(buf_obj, flag) etc.), then
+        falls back to the module-level (comm, ptr, size) signatures.
+        """
+        def _warn_unsupported(kind: str, comm: Any) -> None:
+            key = (kind, type(comm).__name__)
+            if key in _unsupported_warned:
+                return
+            _unsupported_warned.add(key)
+            print(
+                f"[vccl_alloc] WARN: register_kind={kind!r} not supported by "
+                f"this nccl4py for {type(comm).__name__}: no module-level "
+                f"register fn and no comm.register_{kind} method. Pools "
+                f"with this kind will be allocated but NOT registered with "
+                f"this communicator."
+            )
+
+        if kind == REG_BUFFER:
+            # 1) Method on comm: comm.register_buffer(buf_obj) variants.
+            method = (getattr(comm, "register_buffer", None) or
+                      getattr(comm, "registerBuffer", None))
+            if method is not None:
+                for args in ((slab_obj,), (slab_obj, size)):
+                    try:
+                        return (True, method(*args))
+                    except TypeError:
+                        continue
+                    except Exception as e:
+                        print(f"[vccl_alloc] comm.register_buffer{args} on "
+                              f"{comm!r}: {e!r}")
+                        break
+            # 2) Module-level fallback.
+            if _buffer_register is None:
+                _warn_unsupported(REG_BUFFER, comm)
+                return (False, None)
+            try:
+                return (True, _buffer_register(comm, ptr, size))
+            except Exception as e:
+                print(f"[vccl_alloc] buffer register on {comm!r} ptr=0x{ptr:x}: {e!r}")
+                return (False, None)
+
+        if kind == REG_WINDOW:
+            # 1) Method on comm: comm.register_window(buf_obj, flag) variants.
+            method = (getattr(comm, "register_window", None) or
+                      getattr(comm, "registerWindow", None))
+            if method is not None:
+                flag = _WIN_FLAG_COLL_SYMMETRIC
+                attempts = []
+                if flag is not None:
+                    attempts.append((slab_obj, flag))
+                attempts.append((slab_obj,))
+                for args in attempts:
+                    try:
+                        return (True, method(*args))
+                    except TypeError:
+                        continue
+                    except Exception as e:
+                        print(f"[vccl_alloc] comm.register_window{args} on "
+                              f"{comm!r}: {e!r}")
+                        break
+            # 2) Module-level fallback.
+            if _window_register is None:
+                _warn_unsupported(REG_WINDOW, comm)
+                return (False, None)
+            try:
+                return (True, _window_register(comm, ptr, size))
+            except TypeError:
+                try:
+                    return (True, _window_register(comm, ptr, size, 0))
+                except Exception as e:
+                    print(f"[vccl_alloc] window register on {comm!r}: {e!r}")
+                    return (False, None)
+            except Exception as e:
+                print(f"[vccl_alloc] window register on {comm!r} ptr=0x{ptr:x}: {e!r}")
+                return (False, None)
+
+        # REG_NONE
+        return (False, None)
+
+    def _do_deregister(kind: str, comm: Any, ptr: int, size: int,
+                       handle: Any) -> None:
+        if kind == REG_BUFFER:
+            # 1) Method on comm.
+            method = (getattr(comm, "deregister_buffer", None) or
+                      getattr(comm, "deregisterBuffer", None))
+            if method is not None and handle is not None:
+                try:
+                    method(handle)
+                    return
+                except Exception as e:
+                    print(f"[vccl_alloc] comm.deregister_buffer on {comm!r}: {e!r}")
+            # 2) Module-level fallback.
+            if _buffer_deregister is not None:
+                if handle is not None and handle != 0:
+                    _try_call(_buffer_deregister,
+                              (comm, handle), (comm, ptr), (comm, ptr, size))
+                else:
+                    _try_call(_buffer_deregister, (comm, ptr), (comm, ptr, size))
+
+        elif kind == REG_WINDOW:
+            # 1) Method on comm.
+            method = (getattr(comm, "deregister_window", None) or
+                      getattr(comm, "deregisterWindow", None))
+            if method is not None and handle is not None:
+                try:
+                    method(handle)
+                    return
+                except Exception as e:
+                    print(f"[vccl_alloc] comm.deregister_window on {comm!r}: {e!r}")
+            # 2) Module-level fallback.
+            if _window_deregister is not None:
+                if handle is not None and handle != 0:
+                    _try_call(_window_deregister,
+                              (comm, handle), (comm, ptr), (comm, ptr, size))
+                else:
+                    _try_call(_window_deregister, (comm, ptr), (comm, ptr, size))
+        # REG_NONE → nothing to do
+
+    def _apply_registration(info: Dict[str, Any], comm: Any) -> None:
+        """Register `info`'s slab on `comm` with its single configured kind."""
+        kind = info["register_kind"]
+        if kind == REG_NONE:
+            return
+        ok, h = _do_register(kind, comm, info["slab_obj"],
+                             info["slab_ptr"], info["slab_size"])
+        if ok:
+            info["registrations"].append((comm, h))
+            print(f"[vccl_alloc]   pool='{info['name']}' "
+                  f"kind={kind} registered on {comm!r}")
+
+    def _undo_registrations(info: Dict[str, Any], only_comm: Optional[Any] = None) -> None:
+        """Deregister some or all entries in info['registrations']."""
+        kind = info["register_kind"]
+        if kind == REG_NONE:
+            return
+        ptr, size = info["slab_ptr"], info["slab_size"]
+        keep: List[Tuple[Any, Any]] = []
+        for comm, handle in info["registrations"]:
+            if only_comm is not None and comm is not only_comm:
+                keep.append((comm, handle))
+                continue
+            _do_deregister(kind, comm, ptr, size, handle)
+        info["registrations"] = keep
+
+    # =======================================================================
+    # 5. Pool registry API.
+    # =======================================================================
+    def create_pool(name: str,
+                    slot_size: Optional[int] = None,
+                    num_slots: Optional[int] = None,
+                    *,
+                    register_kind: str = REG_BUFFER,
+                    prebuild_slot_tensors: bool = False) -> MemPool:
+        """
+        Create a named pool with its own NCCL-allocated slab.
+
+        Args:
+            name           : unique pool name
+            slot_size      : bytes per slot (default VCCL_ALLOC_SLOT_SIZE)
+            num_slots      : number of slots (default VCCL_ALLOC_NUM_SLOTS)
+            register_kind  : exactly one of REG_BUFFER, REG_WINDOW, REG_NONE.
+                             Determines what NCCL registration is applied to
+                             this pool's slab on every comm passed to
+                             register_for_collectives.
+            prebuild_slot_tensors : if True, build one uint8 slot tensor per
+                             slot at create_pool time. Enables
+                             get_slot_byte_tensor / get_slot_tensor; permanently
+                             claims every slot, so `with in_pool(name)` will
+                             OOM. Mutually exclusive with dynamic-alloc use.
+        """
+        if not name:
+            raise ValueError("pool name must be non-empty")
+        _validate_kind(register_kind)
+
+        slot_size = slot_size or DEFAULT_SLOT_SIZE
+        num_slots = num_slots or DEFAULT_NUM_SLOTS
+        slab_size = slot_size * num_slots
+
+        with _pools_lock:
+            if name in _pools:
+                raise ValueError(f"vccl_alloc: pool '{name}' already exists")
+
+            slab_obj = nccl.mem_alloc(slab_size)
+            slab_ptr = _coerce_ptr(slab_obj)
+            if slab_ptr == 0:
+                raise RuntimeError(f"nccl.mem_alloc returned null for '{name}'")
+
+            name_bytes = name.encode("utf-8")
+            ret = _lib.my_alloc_create_arena(
+                name_bytes,
+                ctypes.c_void_p(slab_ptr),
+                ctypes.c_size_t(slot_size),
+                ctypes.c_int(num_slots),
+                ctypes.c_int(LOCAL_RANK),
+                ctypes.c_int(0),
+            )
+            if ret != 0:
+                if _mem_free is not None and isinstance(slab_obj, int):
+                    try: _mem_free(slab_ptr)
+                    except Exception: pass
+                raise RuntimeError(f"my_alloc_create_arena('{name}') failed: {ret}")
+
+            mempool = MemPool(_my_alloc.allocator())
+
+            # The address assertion below holds because the C ring cursor in
+            # libvccl_arena_allocator hands out slots 0..num_slots-1 in order
+            # for sequential allocations. Pre-building also permanently claims
+            # every slot, so subsequent `with in_pool(name)` allocs on this
+            # pool will OOM — the two contracts are mutually exclusive.
+            slot_byte_tensors: List[torch.Tensor] = []
+            if prebuild_slot_tensors:
+                device_str = f"cuda:{LOCAL_RANK}"
+                _lib.my_alloc_push_arena(name_bytes)
+                try:
+                    with use_mem_pool(mempool):
+                        for i in range(num_slots):
+                            t = torch.empty(slot_size, dtype=torch.uint8,
+                                            device=device_str)
+                            expected = slab_ptr + i * slot_size
+                            if t.data_ptr() != expected:
+                                raise RuntimeError(
+                                    f"vccl_alloc: slot {i} of pool '{name}' "
+                                    f"landed at 0x{t.data_ptr():x}, expected "
+                                    f"0x{expected:x}. PyTorch's caching allocator "
+                                    f"may have split or reordered slot_size "
+                                    f"({slot_size}) — adjust slot_size to align "
+                                    f"with caching-allocator buckets."
+                                )
+                            slot_byte_tensors.append(t)
+                finally:
+                    _lib.my_alloc_pop_arena()
+
+            info: Dict[str, Any] = {
+                "name":              name,
+                "name_bytes":        name_bytes,
+                "mempool":           mempool,
+                "slab_obj":          slab_obj,
+                "slab_ptr":          slab_ptr,
+                "slab_size":         slab_size,
+                "slot_size":         slot_size,
+                "num_slots":         num_slots,
+                "register_kind":     register_kind,
+                "registrations":     [],            # list of (comm, handle)
+                "slot_byte_tensors": slot_byte_tensors,
+                "slot_in_use":       [False] * num_slots,
+            }
+            _pools[name] = info
+
+        print(
+            f"[vccl_alloc] rank={LOCAL_RANK} pool='{name}' "
+            f"slot={slot_size >> 20}MiB x {num_slots} = {slab_size >> 20}MiB "
+            f"ptr=0x{slab_ptr:x} register_kind={register_kind}"
+        )
+
+        with _comms_lock:
+            comms = list(_comms_seen)
+        for comm in comms:
+            _apply_registration(info, comm)
+
+        return mempool
+
+    def destroy_pool(name: str) -> None:
+        with _pools_lock:
+            info = _pools.pop(name, None)
+        if info is None:
+            return
+
+        _undo_registrations(info)
+
+        # Any external refs to slot tensors held past this point will dangle
+        # into freed slab memory once nccl.mem_free runs below.
+        info["slot_byte_tensors"] = []
+
+        info["mempool"] = None
+        gc.collect()
+        try: torch.cuda.synchronize()
+        except Exception: pass
+
+        try:
+            _lib.my_alloc_destroy_arena(info["name_bytes"])
+        except Exception as e:
+            print(f"[vccl_alloc] my_alloc_destroy_arena('{name}'): {e!r}")
+
+        try:
+            owner_handles_free = (
+                not isinstance(info["slab_obj"], int)
+                and any(hasattr(info["slab_obj"], m) for m in ("__del__", "close", "free"))
+            )
+            if not owner_handles_free and _mem_free is not None:
+                _mem_free(info["slab_ptr"])
+        except Exception as e:
+            print(f"[vccl_alloc] nccl mem_free for '{name}': {e!r}")
+
+        print(f"[vccl_alloc] pool '{name}' destroyed")
+
+    def get_pool(name: str) -> Optional[MemPool]:
+        with _pools_lock:
+            info = _pools.get(name)
+            return info["mempool"] if info else None
+
+    def get_pool_backing(name: str) -> Any:
+        """
+        Return the raw nccl.mem_alloc result (NcclBuffer / wrapper / int) for
+        a pool. Useful when you need to register the slab on a comm yourself
+        — e.g., comm.register_window(buf_obj, flag) — instead of going
+        through register_for_collectives(). Required when nccl4py exposes
+        registration as a method on the communicator rather than a
+        module-level function (which is the case in VCCL_MOE).
+        """
+        with _pools_lock:
+            info = _pools.get(name)
+            return info["slab_obj"] if info else None
+
+    def get_pool_slot_size(name: str) -> int:
+        with _pools_lock:
+            info = _pools.get(name)
+            return info["slot_size"] if info else 0
+
+    def get_pool_slot_num(name: str) -> int:
+        """Return the total number of slots in the named pool. 0 if unknown."""
+        with _pools_lock:
+            info = _pools.get(name)
+            return info["num_slots"] if info else 0
+
+    def get_pool_slot_addr(name: str, slot_idx: int) -> int:
+        """Return the device pointer (as an int) of the given slot in the
+        named pool: slab_base + slot_idx * slot_size. Returns 0 if the pool
+        is unknown or slot_idx is out of range [0, num_slots).
+        """
+        with _pools_lock:
+            info = _pools.get(name)
+            if info is None:
+                return 0
+            if slot_idx < 0 or slot_idx >= info["num_slots"]:
+                return 0
+            return info["slab_ptr"] + slot_idx * info["slot_size"]
+
+    def list_pools() -> List[str]:
+        with _pools_lock:
+            return list(_pools.keys())
+
+    # Zero-overhead slot tensors (require prebuild_slot_tensors=True at
+    # create_pool; cached uint8 tensors and views over them).
+    #
+    # Process-global ring cursor for the acquire_* APIs. itertools.count is
+    # atomic under the GIL, so no extra lock is needed. One counter spans
+    # every pool: each call uses cursor % that pool's num_slots.
+    _acquire_counter = itertools.count()
+
+    def get_slot_byte_tensor(name: str, idx: int) -> torch.Tensor:
+        """Return the cached uint8 slot tensor (same object every call). Requires prebuild_slot_tensors=True; lifetime ends at destroy_pool."""
+        with _pools_lock:
+            info = _pools.get(name)
+        if info is None:
+            raise KeyError(
+                f"vccl_alloc: pool '{name}' not registered. "
+                f"Call vccl_alloc.create_pool('{name}', ...) first."
+            )
+        if idx < 0 or idx >= info["num_slots"]:
+            raise IndexError(
+                f"vccl_alloc: slot idx {idx} out of range "
+                f"[0, {info['num_slots']}) for pool '{name}'"
+            )
+        if not info["slot_byte_tensors"]:
+            raise RuntimeError(
+                f"vccl_alloc: pool '{name}' was created without "
+                f"prebuild_slot_tensors=True; get_slot_byte_tensor / "
+                f"get_slot_tensor are unavailable. Recreate the pool with "
+                f"prebuild_slot_tensors=True (it is exclusive with the "
+                f"`with in_pool(...)` dynamic-alloc contract)."
+            )
+        return info["slot_byte_tensors"][idx]
+
+    def get_slot_tensor(name: str, idx: int,
+                        shape: Optional[Sequence[int]] = None,
+                        dtype: Optional["torch.dtype"] = None) -> torch.Tensor:
+        """Return slot `idx` viewed as (shape, dtype). With both omitted, equivalent to get_slot_byte_tensor."""
+        base = get_slot_byte_tensor(name, idx)
+        if shape is None and dtype is None:
+            return base
+        if shape is None or dtype is None:
+            raise ValueError(
+                "get_slot_tensor: pass shape and dtype together, or neither."
+            )
+        numel = 1
+        for d in shape:
+            numel *= int(d)
+        nbytes = numel * _itemsize(dtype)
+        if nbytes > base.numel():
+            raise ValueError(
+                f"vccl_alloc: requested {nbytes} bytes "
+                f"(shape={tuple(shape)}, dtype={dtype}) exceeds "
+                f"slot size {base.numel()} bytes for pool '{name}'."
+            )
+        # Order: slice in bytes, then view-as-dtype, then reshape. Keeps the
+        # intermediate contiguous so the final .view(shape) never copies.
+        return base[:nbytes].view(dtype).view(shape)
+
+    def acquire_slot_byte_tensor(name: str) -> torch.Tensor:
+        """Atomically claim a free slot and return its uint8 backing tensor.
+
+        Search starts at `cursor++ % num_slots` and walks forward; the first
+        free slot is marked in-use and returned. Raises RuntimeError if every
+        slot is held (caller forgot to release, or peak concurrency exceeds
+        num_slots).
+
+        Caller must call release_slot(name, tensor_or_view) when done.
+        """
+        with _pools_lock:
+            info = _pools.get(name)
+            if info is None:
+                raise KeyError(
+                    f"vccl_alloc: pool '{name}' not registered. "
+                    f"Call vccl_alloc.create_pool('{name}', ...) first."
+                )
+            if not info["slot_byte_tensors"]:
+                raise RuntimeError(
+                    f"vccl_alloc: pool '{name}' was created without "
+                    f"prebuild_slot_tensors=True; acquire_slot_byte_tensor / "
+                    f"acquire_slot_tensor are unavailable."
+                )
+            n = info["num_slots"]
+            in_use = info["slot_in_use"]
+            start = next(_acquire_counter) % n
+            for offset in range(n):
+                idx = (start + offset) % n
+                if not in_use[idx]:
+                    in_use[idx] = True
+                    return info["slot_byte_tensors"][idx]
+            held = sum(in_use)
+            raise RuntimeError(
+                f"vccl_alloc: pool '{name}' exhausted ({held}/{n} slots in "
+                f"use). Either a release_slot call is missing, or peak "
+                f"concurrency exceeds num_slots — increase num_slots at "
+                f"create_pool."
+            )
+
+    def acquire_slot_tensor(name: str,
+                            shape: Optional[Sequence[int]] = None,
+                            dtype: Optional["torch.dtype"] = None) -> torch.Tensor:
+        """acquire_slot_byte_tensor + (shape, dtype) view in one step.
+
+        Returns the byte tensor unchanged when shape and dtype are both
+        omitted. Caller must release using release_slot — the returned view
+        carries the slot's data_ptr, so passing it to release works.
+        """
+        base = acquire_slot_byte_tensor(name)
+        if shape is None and dtype is None:
+            return base
+        if shape is None or dtype is None:
+            # Roll back the in-use mark we just set, then complain.
+            release_slot(name, base)
+            raise ValueError(
+                "acquire_slot_tensor: pass shape and dtype together, or neither."
+            )
+        numel = 1
+        for d in shape:
+            numel *= int(d)
+        nbytes = numel * _itemsize(dtype)
+        if nbytes > base.numel():
+            release_slot(name, base)
+            raise ValueError(
+                f"vccl_alloc: requested {nbytes} bytes "
+                f"(shape={tuple(shape)}, dtype={dtype}) exceeds "
+                f"slot size {base.numel()} bytes for pool '{name}'."
+            )
+        return base[:nbytes].view(dtype).view(shape)
+
+    def release_slot(name: str, tensor: torch.Tensor) -> None:
+        """Release a previously-acquired slot.
+
+        `tensor` may be the byte tensor returned by acquire_slot_byte_tensor
+        or any view of it whose data_ptr() falls within the slot's range —
+        the slot index is recovered from `(data_ptr - slab_ptr) // slot_size`.
+        Raises if the pointer is outside the slab or if the slot wasn't held.
+        """
+        with _pools_lock:
+            info = _pools.get(name)
+            if info is None:
+                raise KeyError(
+                    f"vccl_alloc: pool '{name}' not registered."
+                )
+            slab_ptr = info["slab_ptr"]
+            slot_size = info["slot_size"]
+            n = info["num_slots"]
+            ptr = tensor.data_ptr()
+            slab_end = slab_ptr + n * slot_size
+            if ptr < slab_ptr or ptr >= slab_end:
+                raise ValueError(
+                    f"vccl_alloc: tensor data_ptr 0x{ptr:x} is outside "
+                    f"pool '{name}' slab [0x{slab_ptr:x}, 0x{slab_end:x})."
+                )
+            idx = (ptr - slab_ptr) // slot_size
+            if not info["slot_in_use"][idx]:
+                raise RuntimeError(
+                    f"vccl_alloc: slot {idx} of pool '{name}' is not held; "
+                    f"double release?"
+                )
+            info["slot_in_use"][idx] = False
+
+    class _InPoolContext:
+        """Class-based context manager backing in_pool().
+
+        The previous implementation used @contextlib.contextmanager, which
+        wraps a generator: __enter__ advances to the `yield` and __exit__
+        resumes it. That generator setup/teardown is ~10-30us per
+        enter/exit pair on top of the real work — measurable when in_pool
+        is hit once per dispatch() (thousands of times per training step).
+
+        This class form has only plain method dispatch in __enter__ /
+        __exit__. The remaining contextmanager-generator overhead comes
+        from PyTorch's use_mem_pool, which is also
+        @contextlib.contextmanager and which we can't avoid (skipping it
+        would mean allocations stop routing to the pool). One unavoidable
+        generator instead of two.
+        """
+        __slots__ = ("_name_bytes", "_use_mem_pool_cm")
+
+        def __init__(self, name_bytes: bytes, mempool: MemPool):
+            self._name_bytes = name_bytes
+            # Construct the use_mem_pool generator-based ctx now; its
+            # __enter__/__exit__ are deferred to our own.
+            self._use_mem_pool_cm = use_mem_pool(mempool)
+
+        def __enter__(self):
+            _lib.my_alloc_push_arena(self._name_bytes)
+            self._use_mem_pool_cm.__enter__()
+            return self
+
+        def __exit__(self, exc_type, exc_val, tb):
+            try:
+                return self._use_mem_pool_cm.__exit__(exc_type, exc_val, tb)
+            finally:
+                _lib.my_alloc_pop_arena()
+
+    def in_pool(name: str):
+        with _pools_lock:
+            info = _pools.get(name)
+        if info is None:
+            raise KeyError(
+                f"vccl_alloc: pool '{name}' not registered. "
+                f"Call vccl_alloc.create_pool('{name}', ...) first."
+            )
+        return _InPoolContext(info["name_bytes"], info["mempool"])
+
+    # =======================================================================
+    # 6. Communicator registration.
+    # =======================================================================
+    def register_for_collectives(comm: Any) -> None:
+        """
+        Register every existing pool's slab on `comm` with each pool's
+        configured register_kind. Pools created LATER auto-register on this
+        comm too. Idempotent for the same comm.
+        """
+        with _comms_lock:
+            for c in _comms_seen:
+                if c is comm:
+                    return
+            _comms_seen.append(comm)
+
+        with _pools_lock:
+            infos = list(_pools.values())
+
+        print(f"[vccl_alloc] register_for_collectives(comm={comm!r}) "
+              f"applying to {len(infos)} pool(s)")
+        for info in infos:
+            _apply_registration(info, comm)
+
+    def deregister_collectives() -> None:
+        with _comms_lock:
+            comms = list(_comms_seen)
+            _comms_seen.clear()
+        with _pools_lock:
+            infos = list(_pools.values())
+        for info in infos:
+            for comm in comms:
+                _undo_registrations(info, only_comm=comm)
+
+    # =======================================================================
+    # 7. Diagnostics.
+    # =======================================================================
+    def live_count(name: str) -> int:
+        with _pools_lock:
+            info = _pools.get(name)
+        if info is None: return -1
+        try:
+            return int(_lib.my_alloc_arena_live_count(info["name_bytes"]))
+        except Exception:
+            return -1
+
+    def peak_live(name: str) -> int:
+        with _pools_lock:
+            info = _pools.get(name)
+        if info is None: return -1
+        try:
+            return int(_lib.my_alloc_arena_peak_live(info["name_bytes"]))
+        except Exception:
+            return -1
+
+    # =======================================================================
+    # 8. Atexit teardown.
+    # =======================================================================
+    @atexit.register
+    def _teardown() -> None:
+        with _pools_lock:
+            names = list(_pools.keys())
+        for name in names:
+            try:
+                destroy_pool(name)
+            except Exception as e:
+                print(f"[vccl_alloc] destroy_pool('{name}') at teardown: {e!r}")
+
+        g = globals()
+        g.pop("_my_alloc", None)
+        gc.collect()
+        try: torch.cuda.synchronize()
+        except Exception: pass
+
+        try:
+            _lib.my_alloc_shutdown()
+        except Exception as e:
+            print(f"[vccl_alloc] my_alloc_shutdown failed: {e!r}")
