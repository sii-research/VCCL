+class DiffMaskedSelectOut(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, input_tensor, mask, out_buffer):
+        with torch.no_grad():
+            broadcasted_mask = torch.broadcast_to(mask, input_tensor.shape).contiguous()
+            flat_sorted = broadcasted_mask.reshape(-1).argsort(descending=True, stable=True)
+            flat_sorted = flat_sorted[: out_buffer.numel()]
+            torch.index_select(input_tensor.reshape(-1), 0, flat_sorted, out=out_buffer)
+
+        ctx.save_for_backward(flat_sorted)
+        ctx.input_shape = input_tensor.shape
+        ctx.input_dtype = input_tensor.dtype
+        ctx.input_device = input_tensor.device
+
+        return out_buffer
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        (flat_sorted,) = ctx.saved_tensors
+
+        grad_input = torch.zeros(
+            ctx.input_shape,
+            dtype=ctx.input_dtype,
+            device=ctx.input_device,
+        )
+        grad_input = grad_input.reshape(-1)
+        grad_input.index_copy_(0, flat_sorted, grad_output)
+        grad_input = grad_input.view(ctx.input_shape)
+        return grad_input, None, None
