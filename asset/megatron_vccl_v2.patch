+class DiffScatterAddOut(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, input_tensor, sorted_indices, restore_shape, input_token_tensor):
+        with torch.no_grad():
+            output_tensor = torch.zeros(
+                restore_shape, dtype=input_tensor.dtype, device=input_tensor.device
+            )
+            if torch.are_deterministic_algorithms_enabled():
+                output_tensor.index_add_(0, sorted_indices, input_tensor)
+            else:
+                scatter_index = sorted_indices.view(
+                    -1, *([1] * (input_tensor.dim() - 1))
+                ).expand_as(input_tensor)
+                output_tensor.scatter_add_(0, scatter_index, input_tensor)
+
+        ctx.save_for_backward(sorted_indices)
+        ctx.input_token_tensor = input_token_tensor
+        return output_tensor
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        (sorted_indices,) = ctx.saved_tensors
+        if ctx.input_token_tensor is not None:
+            grad_input = torch.index_select(
