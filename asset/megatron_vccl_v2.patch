+def create_vccl_comm(
+    group: torch.distributed.ProcessGroup,
+    symm_mem: bool = True,
+) -> Optional[nccl.Communicator]:
+    """
+    Create an VCCL communicator based on the torch group (torch.distributed.ProcessGroup).
+
+    Args:
+        group: torch.distributed.ProcessGroup object
+
+    Raises:
+        RuntimeError: if unique_id is not received properly
+
+    Returns:
+        VCCL Communicator object if the current rank is in the group, else None
+    """
+    # Get ranks and current rank
+    ranks = torch.distributed.get_process_group_ranks(group)
+    current_rank = torch.distributed.get_rank()
+    if current_rank not in ranks:
+        # Return None if the current rank is not in the group
+        print(
+            f"Create vccl communicator: Rank {current_rank} "
+            f"is not in the specified ranks list {ranks}."
+        )
+        return None
+
+    # Generate unique ID on the root rank
+    root = min(ranks)
+    unique_ids = [nccl.get_unique_id() if current_rank == root else None]
+
+    # Broadcast unique ID to all ranks in the group
+    torch.distributed.broadcast_object_list(unique_ids, src=root, group=group)
+    unique_id = unique_ids[0]
+    if unique_id is None:
+        raise RuntimeError("ERROR: Failed to receive unique_id in create_nccl_group.")
+
+    # Determine local rank and size within the group
+    local_rank = ranks.index(current_rank) if current_rank in ranks else -1
+    local_size = len(ranks)
+
+    # Initialize NCCL communicator for the group
+    nccl_cfg = nccl.NCCLConfig(cta_policy=nccl.CTAPolicy.Zero) if symm_mem else None
+    nccl_comm = nccl.Communicator.init(
+        nranks=local_size,
+        rank=local_rank,
+        unique_id=unique_id,
+        config=nccl_cfg,
+    )
+
+    return nccl_comm
+
+
+_VCCL_EXPERT_PARALLEL_COMM: Optional[nccl.Communicator] = None
+
+
+def get_expert_model_parallel_comm(
+    ep_group: torch.distributed.ProcessGroup,
+) -> nccl.Communicator:
+    """Get the expert-model-parallel group the caller rank belongs to.
+
+    Args:
+        ep_group (torch.distributed.ProcessGroup): The expert-model-parallel group.
+
+    Raises:
+        RuntimeError: If the VCCL communicator cannot be created.
+
+    Returns:
+        nccl.Communicator: The NCCL communicator for the expert-model-parallel group.
+    """
+    global _VCCL_EXPERT_PARALLEL_COMM
+    if _VCCL_EXPERT_PARALLEL_COMM is None:
+        comm = create_vccl_comm(ep_group)
+        if comm is None:
+            raise RuntimeError("Failed to create VCCL communicator")
+        _VCCL_EXPERT_PARALLEL_COMM = comm
+    return _VCCL_EXPERT_PARALLEL_COMM
+
+
+def destroy_expert_model_parallel_comm() -> None:
+    """Destroy the cached expert-model-parallel VCCL communicator."""
+    global _VCCL_EXPERT_PARALLEL_COMM
+    if _VCCL_EXPERT_PARALLEL_COMM is not None:
+        _VCCL_EXPERT_PARALLEL_COMM.destroy()
+    _VCCL_EXPERT_PARALLEL_COMM = None
+
