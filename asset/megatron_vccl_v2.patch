+class DiffTransposeChunksOut(torch.autograd.Function):
+    """Transpose [A, B, C] -> [B, A, C] with pre-allocated backward/forward buffers.
+
+    Used for drop_and_pad mode where the permutation is a fixed transpose pattern.
+
+    Forward: view → transpose → contiguous → flatten (identical to original code).
+    Backward: same transpose pattern via copy_ into grad_out_buffer (zero allocation,
+              same kernel as contiguous()).
+    """
+
+    @staticmethod
+    def forward(ctx, input_tensor, A, B, C, grad_out_buffer, fwd_out_buffer):
+        H = input_tensor.shape[1] if input_tensor.dim() == 2 else 1
+        with torch.no_grad():
+            if fwd_out_buffer is not None:
+                # Write transposed result directly into fwd_out_buffer
+                fwd_out_buffer.view(A, B, C, H).copy_(
+                    input_tensor.view(B, A, C, H).transpose(0, 1)
+                )
+                output = fwd_out_buffer.view(-1, H) if H > 1 else fwd_out_buffer.view(-1)
+            else:
+                if H > 1:
+                    output = (
+                        input_tensor.view(A, B, C, H)
+                        .transpose(0, 1)
+                        .contiguous()
+                        .flatten(start_dim=0, end_dim=2)
+                    )
+                else:
+                    output = (
+                        input_tensor.view(A, B, C)
+                        .transpose(0, 1)
+                        .contiguous()
+                        .flatten()
+                    )
+
+        ctx.A = A
+        ctx.B = B
+        ctx.C = C
+        ctx.H = H
+        ctx.grad_out_buffer = grad_out_buffer
+        return output
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        A, B, C, H = ctx.A, ctx.B, ctx.C, ctx.H
+        # Inverse of [A,B,C]->[B,A,C] is [B,A,C]->[A,B,C] (same transpose)
+        if ctx.grad_out_buffer is not None:
+            if H > 1:
+                ctx.grad_out_buffer.view(A, B, C, H).copy_(
+                    grad_output.view(B, A, C, H).transpose(0, 1)
+                )
+                grad_input = ctx.grad_out_buffer.view(-1, H)
+            else:
+                ctx.grad_out_buffer.view(A, B, C).copy_(
+                    grad_output.view(B, A, C).transpose(0, 1)
+                )
+                grad_input = ctx.grad_out_buffer.view(-1)
+        else:
+            if H > 1:
+                grad_input = (
+                    grad_output.view(B, A, C, H)
+                    .transpose(0, 1)
+                    .contiguous()
+                    .flatten(start_dim=0, end_dim=2)
+                )
+            else:
+                grad_input = (
+                    grad_output.view(B, A, C)
+                    .transpose(0, 1)
+                    .contiguous()
+                    .flatten()
+                )
+        return grad_input, None, None, None, None, None
+
+
+class DiffSortChunksByCatOut(torch.autograd.Function):
+    """Sort chunks by split+cat with pre-allocated backward/forward buffers.
+
+    Used for variable-size chunk sorting where split_sizes change each forward.
+
+    Forward: split + cat (identical to original megatron sort_chunks_by_idxs).
+    Backward: split + cat with inverse permutation, writing into grad_out_buffer
+              (same kernel as original backward, zero allocation).
+    """
+
+    @staticmethod
+    def forward(ctx, input_tensor, grad_out_buffer, fwd_out_buffer,
+                split_sizes_list, sorted_idxs_list):
+        with torch.no_grad():
+            chunks = torch.split(input_tensor, split_sizes_list, dim=0)
+            if fwd_out_buffer is not None:
+                output = torch.cat(
+                    [chunks[i] for i in sorted_idxs_list], dim=0, out=fwd_out_buffer
+                )
+            else:
+                output = torch.cat([chunks[i] for i in sorted_idxs_list], dim=0)
+
+        # Save only lightweight CPU metadata for backward — no GPU ops.
+        ctx.split_sizes_list = split_sizes_list
+        ctx.sorted_idxs_list = sorted_idxs_list
+        ctx.grad_out_buffer = grad_out_buffer
+        return output
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        split_sizes_list = ctx.split_sizes_list
+        sorted_idxs_list = ctx.sorted_idxs_list
+
+        # Output chunk sizes (in sorted order)
+        output_split_sizes = [split_sizes_list[i] for i in sorted_idxs_list]
+        # Inverse permutation: inv[sorted_idxs[i]] = i
+        K = len(sorted_idxs_list)
+        inv_sorted = [0] * K
+        for i, idx in enumerate(sorted_idxs_list):
+            inv_sorted[idx] = i
+
+        # Backward: split grad_output by sorted sizes, cat in original order
+        grad_chunks = torch.split(grad_output, output_split_sizes, dim=0)
+        if ctx.grad_out_buffer is not None:
+            grad_input = torch.cat(
+                [grad_chunks[inv_sorted[j]] for j in range(K)],
+                dim=0, out=ctx.grad_out_buffer,
+            )
+        else:
+            grad_input = torch.cat(
+                [grad_chunks[inv_sorted[j]] for j in range(K)], dim=0
+            )
+
+        return grad_input, None, None, None, None
+
+
+def vccl_sort_chunks_by_idxs(
+    input: torch.Tensor,
+    split_sizes: torch.Tensor,
+    sorted_idxs: torch.Tensor,
+    probs: Optional[torch.Tensor] = None,
+    grad_out_buffer: Optional[torch.Tensor] = None,
+    prob_grad_out_buffer: Optional[torch.Tensor] = None,
+    fwd_out_buffer: Optional[torch.Tensor] = None,
+    prob_fwd_out_buffer: Optional[torch.Tensor] = None,
+    fused: bool = False,
+) -> Tuple[torch.Tensor, Optional[torch.Tensor]]:
+    """Sort chunks by indices, with optional pre-allocated forward/backward buffers.
+
+    Forward uses split+cat (identical to original megatron sort_chunks_by_idxs).
+    Backward uses split+cat with inverse permutation into pre-allocated buffer.
+
+    Args:
+        input: [N, H] token tensor.
+        split_sizes: [K] chunk sizes (sum = N).
+        sorted_idxs: [K] permutation of chunk indices.
+        probs: Optional [N] probability tensor (same permutation applied).
+        grad_out_buffer: Optional [N, H] buffer for token backward output.
+        prob_grad_out_buffer: Optional [N] buffer for prob backward output.
+        fwd_out_buffer: Optional [N, H] buffer for token forward output.
+        prob_fwd_out_buffer: Optional [N] buffer for prob forward output.
+        fused: bool, if True raise error (VCCL does not support fused permute yet).
+
+    Returns:
+        (sorted_tokens, sorted_probs) tuple.
+    """
+    if fused:
+        raise NotImplementedError(
+            "vccl_sort_chunks_by_idxs does not support fused=True (moe_permute_fusion). "
+            "Please set --moe-permute-fusion to False when using VCCL dispatcher."
+        )
+
+    split_sizes_list = split_sizes.tolist()
+    sorted_idxs_list = sorted_idxs.tolist()
+
+    sorted_tokens = DiffSortChunksByCatOut.apply(
+        input, grad_out_buffer, fwd_out_buffer, split_sizes_list, sorted_idxs_list
+    )
+
+    sorted_probs = None
+    if probs is not None:
+        sorted_probs = DiffSortChunksByCatOut.apply(
+            probs, prob_grad_out_buffer, prob_fwd_out_buffer,
+            split_sizes_list, sorted_idxs_list
+        )
+
+    return sorted_tokens, sorted_probs
+
+
+class VcclAlltoAllv(torch.autograd.Function):
+    """VCCL alltoallv operator.
+
+    Notes:
+        We assume that only one of the forward and backward processes will execute at a time,
+        thus allowing us to `reuse` the same memory segment.
+
+    ATTENTION:
+        If debugging issues arise in the future,
+        remember to check the validity of the above assumption.
+    """
+
+    @staticmethod
+    def _invoke_alltoallv(
+        meta: VcclAlltoAllvMeta,
+        sendbuf: torch.Tensor,
+        recvbuf: torch.Tensor,
+        sendcounts: np.ndarray,
+        sdispls: np.ndarray,
+        recvcounts: np.ndarray,
+        rdispls: np.ndarray,
+    ) -> None:
+        """Invoke meta.comm.alltoallv directly — no autograd machinery.
+
+        Used by both forward (fwd direction) and backward (bwd direction).
+        Backward calling this instead of nesting VcclAlltoAllv.apply() avoids
+        a second pytree walk + ctx allocation per backward; bwd-of-bwd
+        never fires in this graph (the bwd alltoall has no autograd-tracked
+        inputs), so the autograd round-trip is pure overhead.
+        """
+        # Fallback only hit when caller didn't pin a stream (e.g. set_streams() not called).
+        stream_ptr = meta.stream_ptr
+        if stream_ptr is None:
+            stream_ptr = torch.cuda.current_stream().cuda_stream
+        meta.comm.alltoallv(
+            sendbuf.data_ptr(),
+            recvbuf.data_ptr(),
+            sendcounts, sdispls, recvcounts, rdispls,
+            meta.dtype,
+            meta.relay_ptr,
+            meta.relay_count,
+            stream=stream_ptr,
+        )
+
+    @staticmethod
+    def forward(
+        ctx,
+        meta: VcclAlltoAllvMeta,
+        sendbuf: torch.Tensor,
+        recvbuf: torch.Tensor,
+    ) -> torch.Tensor:
+        """Forward function. All non-(sendbuf|recvbuf) args live on `meta`.
+
+        We deliberately don't save sendbuf / recvbuf for backward —
+        backward only needs the bwd buffers (already on meta) plus
+        grad_output, and saving the fwd-pass tensors would pin the
+        vccl_alloc slot for the full forward+backward duration with no
+        actual use.
+        """
+        ctx.meta = meta
+        VcclAlltoAllv._invoke_alltoallv(
+            meta, sendbuf, recvbuf,
+            meta.sendcounts, meta.sdispls, meta.recvcounts, meta.rdispls,
+        )
+        return recvbuf
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        """Backward function. Calls _invoke_alltoallv directly to skip the
+        nested Function.apply round-trip; bwd-of-bwd never fires here.
+        """
+        # FIXME: unify the unit of counts and displs
+        #        whether is bytes or elements
+        meta = ctx.meta
+        # Fast path: if grad_output already lives in sendbuf_bwd's storage,
+        # skip the copy. The dispatcher wires fc1 / unpermute to write
+        # their dgrad directly into sendbuf_bwd via the dispatch_dgard /
+        # combine_grad kwargs, so this fast-path triggers for the token
+        # alltoalls. The prob alltoall takes the copy_ branch — TE's
+        # prob-multiply backward doesn't write into our buffer.
+        if grad_output.data_ptr() == meta.sendbuf_bwd_ptr:
+            input_ = grad_output
+        else:
+            input_ = meta.sendbuf_bwd
+            input_.copy_(grad_output)
+
+        VcclAlltoAllv._invoke_alltoallv(
+            meta, input_, meta.recvbuf_bwd,
+            meta.bwd_sendcounts, meta.bwd_sdispls,
+            meta.bwd_recvcounts, meta.bwd_rdispls,
+        )
+
+        # Fire after the bwd alltoallv is queued. By this point the
+        # original recvbuf has no remaining consumers — TE GroupedLinear's
+        # saved tensor was drained inside expert_bwd (which runs before
+        # token_alltoall_bwd) and prob_alltoall_bwd never references the
+        # forward recvbuf.
+        if meta.on_backward_complete is not None:
+            meta.on_backward_complete()
+
+        # Return tuple positions correspond to forward inputs:
+        #   meta, sendbuf, recvbuf
+        # meta.recvbuf_bwd holds grad_sendbuf after the bwd alltoallv.
+        return None, meta.recvbuf_bwd, None
+
+
+DTYPESTR_TO_TYPESTR = {
+    "float32": "<f4",
+    "float64": "<f8",
+    "float16": "<f2",
+    "bfloat16": "<f2",
+    "int32": "<i4",
+    "int64": "<i8",
+    "int16": "<i2",
+    "int8": "<i1",
+    "uint8": "<u1",
+    "bool": "|b1",
+}
+
+TORCHTYPE_TO_TYPESTR = {
+    torch.float32: "<f4",
+    torch.float64: "<f8",
+    torch.float16: "<f2",
+    torch.bfloat16: "<f2",
+    torch.int32: "<i4",
+    torch.int64: "<i8",
+    torch.int16: "<i2",
+    torch.int8: "<i1",
+    torch.uint8: "<u1",
+    torch.bool: "|b1",
+}
+
+DTYPESTR_TO_TORCHTYPE= {
+    "float32": torch.float32,
+    "float64": torch.float64,
+    "float16": torch.float16,
+    "bfloat16": torch.bfloat16,
+    "int32": torch.int32,
+    "int64": torch.int64,
+    "int16": torch.int16,
+    "int8": torch.int8,
+    "uint8": torch.uint8,
+    "bool": torch.bool,
+}
